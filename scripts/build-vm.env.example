# Zugang zur Windows-Build-VM für scripts/remote-build.sh.
# Kopieren nach ~/.config/rog-windows/build-vm.env (NICHT ins Repo) und `chmod 600` setzen.
# Anleitung zum Einrichten der VM: docs/BUILD-VM.md

# Hostname oder IP der VM
ROG_VM_HOST=build-vm.example.invalid
# SSH-Port (Standard 22; bei Portweiterleitung z. B. 2222)
ROG_VM_PORT=22
# Benutzer auf der VM
ROG_VM_USER=builder
# Privater Schlüssel auf dev-linux (öffentlicher Teil steht auf der VM in administrators_authorized_keys bzw. authorized_keys)
ROG_VM_KEY=$HOME/.ssh/rog-windows-builder
# Arbeitsordner relativ zum Profil des Benutzers auf der VM (C:\Users\builder\rog-build)
ROG_VM_DIR=rog-build
# Wie viele Läufe auf der VM liegen bleiben
ROG_VM_KEEP_RUNS=5
# Optional für --mode sideload: Fingerabdruck des Testzertifikats im Speicher CurrentUser\My auf der VM
# (wird als Umgebungsvariable auf der VM gelesen – dort setzen, nicht hier)
