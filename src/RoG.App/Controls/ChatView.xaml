<?xml version="1.0" encoding="utf-8"?>
<!-- Chat-Verlauf mit Eingabe – in der Nachrichten-Seite und im herausgelösten Chat-Fenster. -->
<UserControl
    x:Class="RoG.App.Controls.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:StateView
            x:Uid="ChatView_State"
            ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
            IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.RefreshCommand}" />

        <ListView
            x:Name="MessageList"
            x:Uid="ChatView_List"
            Padding="16,8"
            IncrementalLoadingTrigger="None"
            ItemsSource="{x:Bind ViewModel.Messages}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
            <ListView.Header>
                <Button
                    x:Uid="ChatView_LoadOlder"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadOlderCommand}"
                    Style="{StaticResource RoGSecondaryButtonStyle}"
                    Visibility="{x:Bind ViewModel.HasOlder, Mode=OneWay}" />
            </ListView.Header>
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageViewModel">
                    <Border
                        MaxWidth="560"
                        Padding="12,8"
                        HorizontalAlignment="{x:Bind Alignment}"
                        Background="{x:Bind Background}"
                        BorderBrush="{x:Bind AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        AutomationProperties.Name="{x:Bind AutomationName}">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="ChatView_Reply" Command="{x:Bind ReplyCommand}" Icon="Undo" />
                                <MenuFlyoutItem x:Uid="ChatView_CopyText" Command="{x:Bind CopyCommand}" Icon="Copy" />
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource RoGGoldBrush}"
                                Text="{x:Bind Author}"
                                Visibility="{x:Bind ShowAuthor}" />
                            <Border
                                Padding="8,4"
                                Background="{StaticResource RoGBgBrush}"
                                BorderBrush="{StaticResource RoGRedBrush}"
                                BorderThickness="2,0,0,0"
                                Visibility="{x:Bind HasQuote}">
                                <TextBlock
                                    FontSize="12"
                                    MaxLines="3"
                                    Style="{StaticResource RoGMutedTextStyle}"
                                    Text="{x:Bind Quote}"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>
                            <controls:LinkTextBlock Opacity="{x:Bind BodyOpacity}" Text="{x:Bind Body}" Visibility="{x:Bind HasBody}" />
                            <TextBlock
                                FontSize="12"
                                Style="{StaticResource RoGMutedTextStyle}"
                                Text="{x:Bind Attachments}"
                                Visibility="{x:Bind HasAttachments}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="11"
                                Style="{StaticResource RoGMutedTextStyle}"
                                Text="{x:Bind Time}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar
            Grid.Row="1"
            Margin="16,0"
            IsOpen="{x:Bind ViewModel.IsSendErrorOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.SendError, Mode=OneWay}"
            Severity="Error" />

        <!-- Eingabe -->
        <Grid
            Grid.Row="2"
            Padding="16,8,16,16"
            ColumnSpacing="8"
            RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.ColumnSpan="2"
                Padding="8,4"
                Background="{StaticResource RoGBg3Brush}"
                ColumnSpacing="8"
                CornerRadius="6"
                Visibility="{x:Bind ViewModel.HasQuote, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    MaxLines="1"
                    Style="{StaticResource RoGMutedTextStyle}"
                    Text="{x:Bind ViewModel.QuoteTarget.ReplyPreview, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Uid="ChatView_ClearQuote"
                    Grid.Column="1"
                    Padding="6"
                    Command="{x:Bind ViewModel.ClearQuoteCommand}">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
            <TextBox
                x:Name="Composer"
                x:Uid="ChatView_Composer"
                Grid.Row="1"
                MaxHeight="160"
                AcceptsReturn="True"
                MaxLength="5000"
                PreviewKeyDown="OnComposerKeyDown"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <Button
                x:Uid="ChatView_Send"
                Grid.Row="1"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.SendCommand}"
                Style="{StaticResource RoGPrimaryButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE724;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
