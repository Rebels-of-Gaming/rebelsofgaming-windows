<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RoGBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource RoGReadingWidth}"
            Padding="{StaticResource RoGPagePadding}"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock x:Uid="AccountPage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="KONTO" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Warning" />

            <ProgressRing
                x:Uid="AccountPage_Loading"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- Gastmodus -->
            <Border Style="{StaticResource RoGCardStyle}" Visibility="{x:Bind ViewModel.IsGuest, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="AccountPage_GuestTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock x:Uid="AccountPage_GuestText" Style="{StaticResource RoGBodyTextStyle}" />
                    <Button
                        x:Uid="AccountPage_SignIn"
                        Command="{x:Bind ViewModel.SignInCommand}"
                        Style="{StaticResource RoGPrimaryButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- Profil-Kopf -->
            <Border Style="{StaticResource RoGCardStyle}" Visibility="{x:Bind ViewModel.ShowProfile, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture
                        Width="72"
                        Height="72"
                        DisplayName="{x:Bind ViewModel.Name, Mode=OneWay}"
                        ProfilePicture="{x:Bind ViewModel.Avatar, Mode=OneWay}"
                        AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Style="{StaticResource RoGTitleTextStyle}" Text="{x:Bind ViewModel.Name, Mode=OneWay}" />
                        <TextBlock
                            FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                            FontSize="16"
                            CharacterSpacing="40"
                            Foreground="{StaticResource RoGGoldBrush}"
                            Text="{x:Bind ViewModel.RankText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Squads, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Angaben -->
            <Border Style="{StaticResource RoGCardStyle}" Visibility="{x:Bind ViewModel.ShowProfile, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="AccountPage_DetailsTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="AccountPage_EmailLabel" Style="{StaticResource RoGMutedTextStyle}" />
                        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Email, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="AccountPage_SecurityLabel" Style="{StaticResource RoGMutedTextStyle}" />
                        <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.TwoFactor, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="AccountPage_DeviceLabel" Style="{StaticResource RoGMutedTextStyle}" />
                        <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Joined, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Profil bearbeiten -->
            <Expander
                x:Uid="AccountPage_EditProfile"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Expanding="OnEditExpanding"
                Visibility="{x:Bind ViewModel.ShowProfile, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <InfoBar
                        IsOpen="{x:Bind Editor.IsFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind Editor.FeedbackMessage, Mode=OneWay}"
                        Severity="{x:Bind Editor.FeedbackSeverity, Mode=OneWay}" />
                    <ProgressRing IsActive="{x:Bind Editor.IsLoading, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="AccountPage_ChangeAvatar" Click="OnAvatarClick" Style="{StaticResource RoGSecondaryButtonStyle}" />
                        <Button x:Uid="AccountPage_ChangeBanner" Click="OnBannerClick" Style="{StaticResource RoGSecondaryButtonStyle}" />
                    </StackPanel>
                    <TextBox x:Uid="AccountPage_Motto" MaxLength="120" Text="{x:Bind Editor.Motto, Mode=TwoWay}" />
                    <TextBox
                        x:Uid="AccountPage_Bio"
                        MinHeight="100"
                        AcceptsReturn="True"
                        MaxLength="2000"
                        Text="{x:Bind Editor.Bio, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox x:Uid="AccountPage_City" MinWidth="220" Text="{x:Bind Editor.City, Mode=TwoWay}" />
                        <TextBox x:Uid="AccountPage_Country" MinWidth="160" Text="{x:Bind Editor.Country, Mode=TwoWay}" />
                    </StackPanel>
                    <ToggleSwitch x:Uid="AccountPage_ShowOnMap" IsOn="{x:Bind Editor.ShowOnMap, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="AccountPage_ShowOnline" IsOn="{x:Bind Editor.ShowOnlineStatus, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="AccountPage_HallOfFame" IsOn="{x:Bind Editor.HallOfFameConsent, Mode=TwoWay}" />
                    <Button x:Uid="AccountPage_SaveProfile" Command="{x:Bind Editor.SaveCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                </StackPanel>
            </Expander>

            <!-- Aktionen -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}">
                <Button
                    x:Uid="AccountPage_OpenProfile"
                    Command="{x:Bind ViewModel.OpenProfileCommand}"
                    Style="{StaticResource RoGSecondaryButtonStyle}" />
                <Button
                    x:Uid="AccountPage_ManageOnWebsite"
                    Command="{x:Bind ViewModel.OpenWebsiteAccountCommand}"
                    Style="{StaticResource RoGSecondaryButtonStyle}" />
            </StackPanel>
            <TextBlock
                x:Uid="AccountPage_ManageHint"
                Style="{StaticResource RoGMutedTextStyle}"
                Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />

            <Button
                x:Uid="AccountPage_SignOut"
                Click="OnSignOutClick"
                IsEnabled="{x:Bind ViewModel.CanSignOut, Mode=OneWay}"
                Style="{StaticResource RoGPrimaryButtonStyle}"
                Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
