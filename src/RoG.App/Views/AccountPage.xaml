<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource RoGReadingWidth}"
            Padding="{StaticResource RoGPagePadding}"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock x:Uid="AccountPage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="KONTO" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Warning" />

            <ProgressRing
                x:Uid="AccountPage_Loading"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- Gastmodus -->
            <Border Style="{StaticResource RoGCardStyle}" Visibility="{x:Bind ViewModel.IsGuest, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="AccountPage_GuestTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock x:Uid="AccountPage_GuestText" Style="{StaticResource RoGBodyTextStyle}" />
                    <Button
                        x:Uid="AccountPage_SignIn"
                        Command="{x:Bind ViewModel.SignInCommand}"
                        Style="{StaticResource RoGPrimaryButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- Profil-Kopf -->
            <Border Style="{StaticResource RoGCardStyle}" Visibility="{x:Bind ViewModel.ShowProfile, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture
                        Width="72"
                        Height="72"
                        DisplayName="{x:Bind ViewModel.Name, Mode=OneWay}"
                        ProfilePicture="{x:Bind ViewModel.Avatar, Mode=OneWay}"
                        AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Style="{StaticResource RoGTitleTextStyle}" Text="{x:Bind ViewModel.Name, Mode=OneWay}" />
                        <TextBlock
                            FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                            FontSize="16"
                            CharacterSpacing="40"
                            Foreground="{StaticResource RoGGoldBrush}"
                            Text="{x:Bind ViewModel.RankText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Squads, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Angaben -->
            <Border Style="{StaticResource RoGCardStyle}" Visibility="{x:Bind ViewModel.ShowProfile, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="AccountPage_DetailsTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="AccountPage_EmailLabel" Style="{StaticResource RoGMutedTextStyle}" />
                        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Email, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="AccountPage_SecurityLabel" Style="{StaticResource RoGMutedTextStyle}" />
                        <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.TwoFactor, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="AccountPage_DeviceLabel" Style="{StaticResource RoGMutedTextStyle}" />
                        <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Joined, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Profil bearbeiten -->
            <Expander
                x:Uid="AccountPage_EditProfile"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Expanding="OnEditExpanding"
                Visibility="{x:Bind ViewModel.ShowProfile, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <InfoBar
                        IsOpen="{x:Bind Editor.IsFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind Editor.FeedbackMessage, Mode=OneWay}"
                        Severity="{x:Bind Editor.FeedbackSeverity, Mode=OneWay}" />
                    <ProgressRing IsActive="{x:Bind Editor.IsLoading, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="AccountPage_ChangeAvatar" Click="OnAvatarClick" Style="{StaticResource RoGSecondaryButtonStyle}" />
                        <Button x:Uid="AccountPage_ChangeBanner" Click="OnBannerClick" Style="{StaticResource RoGSecondaryButtonStyle}" />
                    </StackPanel>
                    <TextBox x:Uid="AccountPage_Motto" MaxLength="120" Text="{x:Bind Editor.Motto, Mode=TwoWay}" />
                    <TextBox
                        x:Uid="AccountPage_Bio"
                        MinHeight="100"
                        AcceptsReturn="True"
                        MaxLength="2000"
                        Text="{x:Bind Editor.Bio, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox x:Uid="AccountPage_City" MinWidth="220" Text="{x:Bind Editor.City, Mode=TwoWay}" />
                        <TextBox x:Uid="AccountPage_Country" MinWidth="160" Text="{x:Bind Editor.Country, Mode=TwoWay}" />
                    </StackPanel>
                    <ToggleSwitch x:Uid="AccountPage_ShowOnMap" IsOn="{x:Bind Editor.ShowOnMap, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="AccountPage_ShowOnline" IsOn="{x:Bind Editor.ShowOnlineStatus, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="AccountPage_HallOfFame" IsOn="{x:Bind Editor.HallOfFameConsent, Mode=TwoWay}" />
                    <Button x:Uid="AccountPage_SaveProfile" Command="{x:Bind Editor.SaveCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                </StackPanel>
            </Expander>

            <!-- Meine Bewerbungen -->
            <Expander
                x:Uid="AccountPage_Applications"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Expanding="OnApplicationsExpanding"
                Visibility="{x:Bind ViewModel.ShowProfile, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <InfoBar
                        IsOpen="{x:Bind Applications.IsFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind Applications.FeedbackMessage, Mode=OneWay}"
                        Severity="{x:Bind Applications.FeedbackSeverity, Mode=OneWay}" />
                    <TextBlock x:Uid="AccountPage_ApplicationsEmpty" Style="{StaticResource RoGMutedTextStyle}" Visibility="{x:Bind Applications.IsEmpty, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind Applications.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MyApplicationViewModel">
                                <Border Margin="0,0,0,12" Background="{StaticResource RoGBg3Brush}" CornerRadius="{StaticResource RoGControlRadius}" Padding="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" />
                                        <ProgressBar Maximum="100" Value="{x:Bind Progress}" />
                                        <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Details}" />
                                        <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Timeline}" />
                                        <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Tasks}" Visibility="{x:Bind HasTasks}" />
                                        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Messages}" Visibility="{x:Bind HasMessages}" />
                                        <StackPanel Spacing="8" Visibility="{x:Bind IsOpen}">
                                            <TextBox x:Uid="AccountPage_ApplicationMessage" AcceptsReturn="True" Text="{x:Bind Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Uid="AccountPage_ApplicationSend" Command="{x:Bind SendCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                                                <Button x:Uid="AccountPage_ApplicationWithdraw" Command="{x:Bind WithdrawCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- Abwesenheit -->
            <Expander
                x:Uid="AccountPage_Absences"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Expanding="OnAbsencesExpanding"
                Visibility="{x:Bind ViewModel.ShowProfile, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <InfoBar
                        IsOpen="{x:Bind Absences.IsFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind Absences.FeedbackMessage, Mode=OneWay}"
                        Severity="{x:Bind Absences.FeedbackSeverity, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CalendarDatePicker x:Uid="AccountPage_AbsenceFrom" Date="{x:Bind Absences.From, Mode=TwoWay}" />
                        <CalendarDatePicker x:Uid="AccountPage_AbsenceTo" Date="{x:Bind Absences.To, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBox x:Uid="AccountPage_AbsenceReason" MaxLength="500" Text="{x:Bind Absences.Reason, Mode=TwoWay}" />
                    <Button x:Uid="AccountPage_AbsenceReport" Command="{x:Bind Absences.ReportCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Absences.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AbsenceItemViewModel">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Period}" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Detail}" />
                                    </StackPanel>
                                    <Button x:Uid="AccountPage_AbsenceDelete" Grid.Column="1" Command="{x:Bind DeleteCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- Minecraft: Code aus /link prüfen und bestätigen (nie automatisch einlösen) -->
            <Expander
                x:Name="MinecraftExpander"
                x:Uid="AccountPage_Minecraft"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Expanding="OnMinecraftExpanding"
                Visibility="{x:Bind ViewModel.ShowProfile, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <InfoBar
                        IsOpen="{x:Bind Minecraft.IsFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind Minecraft.FeedbackMessage, Mode=OneWay}"
                        Severity="{x:Bind Minecraft.FeedbackSeverity, Mode=OneWay}" />
                    <TextBlock x:Uid="AccountPage_MinecraftIntro" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="AccountPage_MinecraftSignIn" Foreground="{StaticResource RoGGoldBrush}" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" Visibility="{x:Bind Minecraft.NeedsSignIn}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Minecraft.CanLink}">
                        <TextBox
                            x:Name="MinecraftCodeBox"
                            x:Uid="AccountPage_MinecraftCode"
                            Width="200"
                            CharacterCasing="Upper"
                            FontFamily="Consolas"
                            MaxLength="12"
                            Text="{x:Bind Minecraft.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Uid="AccountPage_MinecraftCheck" VerticalAlignment="Bottom" Command="{x:Bind Minecraft.CheckCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                        <ProgressRing Width="20" Height="20" VerticalAlignment="Bottom" IsActive="{x:Bind Minecraft.IsBusy, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock x:Uid="AccountPage_MinecraftEmpty" Style="{StaticResource RoGMutedTextStyle}" Visibility="{x:Bind Minecraft.IsEmpty, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind Minecraft.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MinecraftAccountItemViewModel">
                                <Grid Padding="0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Name}" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" TextWrapping="Wrap" />
                                        <TextBlock FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Uuid}" />
                                    </StackPanel>
                                    <Button x:Uid="AccountPage_MinecraftUnlink" Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind UnlinkCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Spacing="4" Visibility="{x:Bind Minecraft.HasAccounts, Mode=OneWay}">
                        <ToggleSwitch x:Uid="AccountPage_MinecraftWebsiteMessages" IsEnabled="{x:Bind Minecraft.CanLink}" IsOn="{x:Bind Minecraft.ShowWebsiteMessages, Mode=TwoWay}" />
                        <TextBlock x:Uid="AccountPage_MinecraftWebsiteMessagesHint" FontSize="12" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Geräte & Daten -->
            <Expander
                x:Uid="AccountPage_Data"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Expanding="OnDataExpanding"
                Visibility="{x:Bind ViewModel.ShowProfile, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <InfoBar
                        IsOpen="{x:Bind Data.IsFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind Data.FeedbackMessage, Mode=OneWay}"
                        Severity="{x:Bind Data.FeedbackSeverity, Mode=OneWay}" />
                    <TextBlock x:Uid="AccountPage_DevicesTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Data.Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceItemViewModel">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Name}" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                    </StackPanel>
                                    <Button x:Uid="AccountPage_DeviceRemove" Grid.Column="1" Command="{x:Bind RemoveCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Uid="AccountPage_ExportTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock x:Uid="AccountPage_ExportText" Style="{StaticResource RoGMutedTextStyle}" />
                    <Button x:Uid="AccountPage_ExportRequest" Command="{x:Bind Data.RequestExportCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Data.Exports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExportItemViewModel">
                                <StackPanel Padding="0,4" Orientation="Horizontal" Spacing="12">
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Text}" />
                                    <Button x:Uid="AccountPage_ExportDownload" Command="{x:Bind DownloadCommand}" Visibility="{x:Bind IsReady}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Uid="AccountPage_DeleteTitle" Foreground="{StaticResource RoGRedBrush}" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock x:Uid="AccountPage_DeleteText" Style="{StaticResource RoGMutedTextStyle}" />
                    <Button x:Uid="AccountPage_Delete" Click="OnDeleteAccountClick" Style="{StaticResource RoGSecondaryButtonStyle}" />
                </StackPanel>
            </Expander>

            <!-- Aktionen -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}">
                <Button
                    x:Uid="AccountPage_OpenProfile"
                    Command="{x:Bind ViewModel.OpenProfileCommand}"
                    Style="{StaticResource RoGSecondaryButtonStyle}" />
                <Button
                    x:Uid="AccountPage_ManageOnWebsite"
                    Command="{x:Bind ViewModel.OpenWebsiteAccountCommand}"
                    Style="{StaticResource RoGSecondaryButtonStyle}" />
            </StackPanel>
            <TextBlock
                x:Uid="AccountPage_ManageHint"
                Style="{StaticResource RoGMutedTextStyle}"
                Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />

            <Button
                x:Uid="AccountPage_SignOut"
                Click="OnSignOutClick"
                IsEnabled="{x:Bind ViewModel.CanSignOut, Mode=OneWay}"
                Style="{StaticResource RoGPrimaryButtonStyle}"
                Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
