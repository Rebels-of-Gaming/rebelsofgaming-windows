<?xml version="1.0" encoding="utf-8"?>
<!-- Allgemeiner Editor für einen Bereich der Website-Verwaltung: Liste links, Formular rechts (Felder aus AdminArea). -->
<Window
    x:Class="RoG.App.Views.AdminEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels">

    <Grid Background="{StaticResource RoGBgBrush}">
        <Grid.Resources>
            <controls:AdminFieldTemplateSelector x:Key="FieldTemplates">
                <controls:AdminFieldTemplateSelector.Text>
                    <DataTemplate x:DataType="vm:AdminFieldViewModel">
                        <StackPanel Spacing="4">
                            <TextBox
                                MinHeight="{x:Bind MinTextHeight}"
                                AcceptsReturn="{x:Bind AcceptsReturn}"
                                Header="{x:Bind Label}"
                                IsEnabled="{x:Bind IsEnabled}"
                                MaxLength="{x:Bind MaxLength}"
                                PlaceholderText="{x:Bind Placeholder}"
                                Text="{x:Bind Text, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Help}" TextWrapping="Wrap" Visibility="{x:Bind HasHelp}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource RoGRedBrush}" Text="{x:Bind Error, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind HasError, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </controls:AdminFieldTemplateSelector.Text>
                <controls:AdminFieldTemplateSelector.Toggle>
                    <DataTemplate x:DataType="vm:AdminFieldViewModel">
                        <StackPanel Spacing="4">
                            <ToggleSwitch Header="{x:Bind Label}" IsEnabled="{x:Bind IsEnabled}" IsOn="{x:Bind IsOn, Mode=TwoWay}" />
                            <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Help}" TextWrapping="Wrap" Visibility="{x:Bind HasHelp}" />
                        </StackPanel>
                    </DataTemplate>
                </controls:AdminFieldTemplateSelector.Toggle>
                <controls:AdminFieldTemplateSelector.Choice>
                    <DataTemplate x:DataType="vm:AdminFieldViewModel">
                        <StackPanel Spacing="4">
                            <ComboBox
                                MinWidth="260"
                                DisplayMemberPath="Label"
                                Header="{x:Bind Label}"
                                IsEnabled="{x:Bind IsEnabled}"
                                ItemsSource="{x:Bind Choices}"
                                SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}" />
                            <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Help}" TextWrapping="Wrap" Visibility="{x:Bind HasHelp}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource RoGRedBrush}" Text="{x:Bind Error, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind HasError, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </controls:AdminFieldTemplateSelector.Choice>
                <controls:AdminFieldTemplateSelector.Translated>
                    <DataTemplate x:DataType="vm:AdminFieldViewModel">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Label}" />
                            <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind PartialHint}" TextWrapping="Wrap" Visibility="{x:Bind HasPartialHint}" />
                            <TextBox
                                x:Uid="AdminForm_LangDe"
                                Visibility="{x:Bind ShowDe}"
                                MinHeight="{x:Bind MinTextHeight}"
                                AcceptsReturn="{x:Bind AcceptsReturn}"
                                IsEnabled="{x:Bind IsEnabled}"
                                MaxLength="{x:Bind MaxLength}"
                                Text="{x:Bind De, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Uid="AdminForm_LangEn"
                                Visibility="{x:Bind ShowEn}"
                                MinHeight="{x:Bind MinTextHeight}"
                                AcceptsReturn="{x:Bind AcceptsReturn}"
                                IsEnabled="{x:Bind IsEnabled}"
                                MaxLength="{x:Bind MaxLength}"
                                Text="{x:Bind En, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Uid="AdminForm_LangFr"
                                Visibility="{x:Bind ShowFr}"
                                MinHeight="{x:Bind MinTextHeight}"
                                AcceptsReturn="{x:Bind AcceptsReturn}"
                                IsEnabled="{x:Bind IsEnabled}"
                                MaxLength="{x:Bind MaxLength}"
                                Text="{x:Bind Fr, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Help}" TextWrapping="Wrap" Visibility="{x:Bind HasHelp}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource RoGRedBrush}" Text="{x:Bind Error, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind HasError, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </controls:AdminFieldTemplateSelector.Translated>
            </controls:AdminFieldTemplateSelector>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Padding="16,0,140,0" Background="{StaticResource RoGBg2Brush}">
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                FontSize="14"
                CharacterSpacing="60"
                Foreground="{StaticResource RoGMutedBrush}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="16,8,16,0"
            IsOpen="{x:Bind ViewModel.IsFeedbackOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.FeedbackSeverity, Mode=OneWay}" />

        <Grid Grid.Row="2" Padding="16,8,16,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Liste (nicht bei Einstellungen) -->
            <Grid RowSpacing="8" Visibility="{x:Bind ViewModel.ShowList}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button
                    x:Uid="AdminForm_NewButton"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.NewCommand}"
                    Style="{StaticResource RoGPrimaryButtonStyle}"
                    Visibility="{x:Bind ViewModel.CanCreate}" />
                <AutoSuggestBox
                    x:Uid="AdminForm_Search"
                    Grid.Row="1"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.Search, Mode=TwoWay}" />
                <ProgressRing Grid.Row="2" VerticalAlignment="Top" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    x:Uid="AdminForm_Empty"
                    Grid.Row="2"
                    Style="{StaticResource RoGMutedTextStyle}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                <ListView
                    x:Uid="AdminForm_List"
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.Records}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdminRecordViewModel">
                            <StackPanel Padding="0,6" AutomationProperties.Name="{x:Bind Title}">
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasSubtitle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Uid="AdminForm_More" Grid.Row="3" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.MoreCommand}" Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
            </Grid>

            <!-- Formular -->
            <ScrollViewer x:Name="FormPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.HasForm, Mode=OneWay}">
                <StackPanel MaxWidth="{StaticResource RoGReadingWidth}" Padding="0,0,16,24" HorizontalAlignment="Left" Spacing="14">
                    <TextBlock Style="{StaticResource RoGTitleTextStyle}" Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Help}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasHelp}" />
                    <ItemsControl IsTabStop="False" ItemTemplateSelector="{StaticResource FieldTemplates}" ItemsSource="{x:Bind ViewModel.Fields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="AdminForm_Save" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" Visibility="{x:Bind ViewModel.CanSave, Mode=OneWay}" />
                        <Button x:Uid="AdminForm_Delete" Command="{x:Bind ViewModel.DeleteCommand}" Visibility="{x:Bind ViewModel.CanDelete, Mode=OneWay}" />
                        <Button x:Uid="AdminForm_OpenWeb" Command="{x:Bind ViewModel.OpenWebCommand}" Visibility="{x:Bind ViewModel.HasWebPath}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <TextBlock
                x:Uid="AdminForm_SelectHint"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource RoGMutedTextStyle}"
                Visibility="{x:Bind ViewModel.HasNoForm, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
