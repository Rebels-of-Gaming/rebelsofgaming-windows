<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.AdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:admin="using:RoG.Core.Features.Admin"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Grid Padding="{StaticResource RoGPagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="AdminPage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="VERWALTUNG" />
        <SelectorBar x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Name="OverviewTab" x:Uid="AdminPage_TabOverview" />
            <SelectorBarItem x:Name="MembersTab" x:Uid="AdminPage_TabMembers" />
            <SelectorBarItem x:Name="ApplicationsTab" x:Uid="AdminPage_TabApplications" />
            <SelectorBarItem x:Name="ReportsTab" x:Uid="AdminPage_TabReports" />
            <SelectorBarItem x:Name="BansTab" x:Uid="AdminPage_TabBans" />
            <SelectorBarItem x:Name="LogTab" x:Uid="AdminPage_TabLog" />
            <SelectorBarItem x:Name="WordsTab" x:Uid="AdminPage_TabWords" />
            <SelectorBarItem x:Name="GalleryTab" x:Uid="AdminPage_TabGallery" />
            <SelectorBarItem x:Name="UploadsTab" x:Uid="AdminPage_TabUploads" />
            <SelectorBarItem x:Name="WebsiteTab" x:Uid="AdminPage_TabWebsite" />
        </SelectorBar>
        <InfoBar
            Grid.Row="2"
            IsOpen="{x:Bind Moderation.IsFeedbackOpen, Mode=TwoWay}"
            Message="{x:Bind Moderation.FeedbackMessage, Mode=OneWay}"
            Severity="{x:Bind Moderation.FeedbackSeverity, Mode=OneWay}" />

        <TextBlock
            x:Name="NoAccess"
            x:Uid="AdminPage_NoAccess"
            Grid.Row="3"
            Style="{StaticResource RoGMutedTextStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- Übersicht -->
        <ScrollViewer x:Name="OverviewPanel" Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Spacing="16">
                <ItemsRepeater ItemsSource="{x:Bind Overview.Kpis}">
                    <ItemsRepeater.Layout>
                        <!-- UniformGridLayout misst nur das erste Element: Höhe für zwei Zeilen Beschriftung reservieren -->
                        <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="12" MinItemHeight="124" MinItemWidth="200" MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="admin:Kpi">
                            <Border Style="{StaticResource RoGCardStyle}" AutomationProperties.Name="{x:Bind Label}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Label}" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock FontFamily="{StaticResource RoGDisplaySemiBoldFont}" FontSize="32" Foreground="{StaticResource RoGInkBrush}" Text="{x:Bind Value}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel Spacing="8" Visibility="{x:Bind Overview.CanSystem}">
                    <TextBlock x:Uid="AdminPage_SystemTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock FontWeight="SemiBold" Foreground="{x:Bind Overview.SystemBrush, Mode=OneWay}" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Overview.SystemText, Mode=OneWay}" />
                    <ItemsControl MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" ItemsSource="{x:Bind Overview.Checks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SystemCheckViewModel">
                                <Grid Padding="0,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Foreground="{x:Bind IconBrush}" Text="{x:Bind Icon}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource RoGBodyTextStyle}">
                                            <Run FontWeight="SemiBold" Text="{x:Bind Label}" /><Run Text="  " /><Run Foreground="{StaticResource RoGMutedBrush}" Text="{x:Bind Value}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Help}" TextWrapping="Wrap" Visibility="{x:Bind HasHelp}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8" Visibility="{x:Bind Overview.CanAudit}">
                    <TextBlock x:Uid="AdminPage_AuditTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <AutoSuggestBox x:Uid="AdminPage_AuditSearch" MaxWidth="420" HorizontalAlignment="Left" QueryIcon="Find" QuerySubmitted="OnAuditSearch" Text="{x:Bind Overview.AuditSearch, Mode=TwoWay}" />
                    <ItemsControl MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" ItemsSource="{x:Bind Overview.Audit}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Padding="0,3" FontSize="13" IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Uid="Common_LoadMore" Command="{x:Bind Overview.MoreAuditCommand}" Visibility="{x:Bind Overview.HasMoreAudit, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Mitglieder -->
        <Grid x:Name="MembersPanel" Grid.Row="3" ColumnSpacing="16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ComboBox x:Uid="AdminPage_StatusFilter" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Members.StatusOptions}" SelectedItem="{x:Bind Members.SelectedStatus, Mode=TwoWay}" />
                <AutoSuggestBox x:Uid="AdminPage_MemberSearch" Grid.Row="1" QueryIcon="Find" QuerySubmitted="OnMemberSearch" Text="{x:Bind Members.Search, Mode=TwoWay}" />
                <ListView Grid.Row="2" ItemsSource="{x:Bind Members.Items}" SelectedItem="{x:Bind Members.Selected, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemberAdminRowViewModel">
                            <StackPanel Padding="0,6" AutomationProperties.Name="{x:Bind Name}">
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Name}" />
                                <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Footer>
                        <Button x:Uid="Common_LoadMore" Margin="0,8" Command="{x:Bind Members.MoreCommand}" Visibility="{x:Bind Members.HasMore, Mode=OneWay}" />
                    </ListView.Footer>
                </ListView>
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind Members.HasDetail, Mode=OneWay}">
                <StackPanel MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" Spacing="12">
                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGTitleTextStyle}" Text="{x:Bind Members.Header, Mode=OneWay}" />
                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Members.AccountText, Mode=OneWay}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="AccountPage_OpenProfile" Command="{x:Bind Members.OpenProfileCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                        <Button x:Uid="AdminPage_Moderate" Command="{x:Bind Members.ModerateMemberCommand}" Visibility="{x:Bind Members.CanModerate}" />
                    </StackPanel>
                    <TextBlock x:Uid="AdminPage_Roles" Style="{StaticResource RoGSectionTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Members.Roles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoleAssignmentViewModel">
                                <StackPanel Padding="0,4" Orientation="Horizontal" Spacing="12">
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Text}" />
                                    <HyperlinkButton x:Uid="AdminPage_RevokeRole" Padding="0" Command="{x:Bind RevokeCommand}" Visibility="{x:Bind CanRevoke}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Members.CanAssign}">
                        <ComboBox x:Uid="AdminPage_Role" MinWidth="200" ItemsSource="{x:Bind Members.RoleOptions}" SelectedItem="{x:Bind Members.SelectedRole, Mode=TwoWay}" />
                        <ComboBox x:Uid="AdminPage_RoleScope" MinWidth="180" ItemsSource="{x:Bind Members.ScopeOptions}" SelectedItem="{x:Bind Members.SelectedScope, Mode=TwoWay}" />
                        <Button x:Uid="AdminPage_AssignRole" VerticalAlignment="Bottom" Command="{x:Bind Members.AssignCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bewerbungen -->
        <Grid x:Name="ApplicationsPanel" Grid.Row="3" ColumnSpacing="16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ComboBox x:Uid="AdminPage_StatusFilter" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Applications.StatusOptions}" SelectedItem="{x:Bind Applications.SelectedStatus, Mode=TwoWay}" />
                <AutoSuggestBox x:Uid="AdminPage_AppSearch" Grid.Row="1" QueryIcon="Find" QuerySubmitted="OnAppSearch" Text="{x:Bind Applications.Search, Mode=TwoWay}" />
                <ListView Grid.Row="2" ItemsSource="{x:Bind Applications.Items}" SelectedItem="{x:Bind Applications.Selected, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ApplicationRowViewModel">
                            <StackPanel Padding="0,6" AutomationProperties.Name="{x:Bind Title}">
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Footer>
                        <Button x:Uid="Common_LoadMore" Margin="0,8" Command="{x:Bind Applications.MoreCommand}" Visibility="{x:Bind Applications.HasMore, Mode=OneWay}" />
                    </ListView.Footer>
                </ListView>
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind Applications.HasDetail, Mode=OneWay}">
                <StackPanel MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" Spacing="12">
                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGTitleTextStyle}" Text="{x:Bind Applications.Header, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{StaticResource RoGGoldBrush}" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Applications.VoteText, Mode=OneWay}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Applications.CanReview}">
                        <ComboBox x:Uid="AdminPage_Decision" MinWidth="200" ItemsSource="{x:Bind Applications.DecisionOptions}" SelectedItem="{x:Bind Applications.SelectedDecision, Mode=TwoWay}" />
                        <Button x:Uid="AdminPage_DecideButton" VerticalAlignment="Bottom" Command="{x:Bind Applications.DecideCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                        <Button x:Uid="AdminPage_Remind" VerticalAlignment="Bottom" Command="{x:Bind Applications.RemindCommand}" />
                    </StackPanel>
                    <TextBlock x:Uid="AdminPage_Answers" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Applications.AnswersText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="AdminPage_Checks" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Applications.ChecksText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="AdminPage_Activity" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Applications.ActivityText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="AdminPage_Tasks" Style="{StaticResource RoGSectionTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Applications.Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AdminTaskViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox Content="{x:Bind Title}" IsChecked="{x:Bind Done, Mode=TwoWay}" />
                                    <HyperlinkButton x:Uid="Backup_Delete" Padding="0" Command="{x:Bind DeleteCommand}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Applications.CanReview}">
                        <TextBox x:Uid="AdminPage_NewTask" Width="280" Text="{x:Bind Applications.NewTask, Mode=TwoWay}" />
                        <Button x:Uid="AdminPage_AddTask" Command="{x:Bind Applications.AddTaskCommand}" />
                    </StackPanel>
                    <TextBlock x:Uid="AdminPage_Timeline" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Applications.TimelineText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="AdminPage_Messages" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Applications.MessagesText, Mode=OneWay}" TextWrapping="Wrap" />
                    <StackPanel Spacing="8" Visibility="{x:Bind Applications.CanReview}">
                        <TextBox x:Uid="AdminPage_NewMessage" AcceptsReturn="True" Text="{x:Bind Applications.NewMessage, Mode=TwoWay}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CheckBox x:Uid="AdminPage_Internal" IsChecked="{x:Bind Applications.MessageInternal, Mode=TwoWay}" />
                            <Button x:Uid="AccountPage_ApplicationSend" Command="{x:Bind Applications.SendMessageCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Meldungen -->
        <Grid x:Name="ReportsPanel" Grid.Row="3" RowSpacing="8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Uid="AdminPage_StatusFilter" MinWidth="160" ItemsSource="{x:Bind Moderation.StatusOptions}" SelectedItem="{x:Bind Moderation.SelectedStatus, Mode=TwoWay}" />
                <ComboBox x:Uid="AdminPage_ReasonFilter" MinWidth="200" ItemsSource="{x:Bind Moderation.ReasonOptions}" SelectedItem="{x:Bind Moderation.SelectedReason, Mode=TwoWay}" />
                <Button x:Uid="Backup_Reload" Command="{x:Bind Moderation.ReloadReportsCommand}" />
                <ProgressRing Width="20" Height="20" IsActive="{x:Bind Moderation.IsBusy, Mode=OneWay}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" Spacing="12">
                    <ItemsControl ItemsSource="{x:Bind Moderation.Reports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReportItemViewModel">
                                <Border Margin="0,0,0,12" Style="{StaticResource RoGCardStyle}" AutomationProperties.Name="{x:Bind Title}">
                                    <StackPanel Spacing="6">
                                        <Border Style="{StaticResource RoGAlertBadgeStyle}" Visibility="{x:Bind IsChildSafety}">
                                            <TextBlock x:Uid="AdminPage_ChildSafetyBadge" Style="{StaticResource RoGAlertBadgeTextStyle}" />
                                        </Border>
                                        <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" TextWrapping="Wrap" />
                                        <Border Padding="10" Background="{StaticResource RoGBg3Brush}" CornerRadius="{StaticResource RoGControlRadius}" Visibility="{x:Bind HasExcerpt}">
                                            <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Excerpt}" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock FontStyle="Italic" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Comment}" TextWrapping="Wrap" Visibility="{x:Bind HasComment}" />
                                        <HyperlinkButton x:Uid="AdminPage_OpenReported" Padding="0" Command="{x:Bind OpenContentCommand}" Visibility="{x:Bind HasUrl}" />
                                        <StackPanel Spacing="8" Visibility="{x:Bind IsOpen}">
                                            <TextBox x:Uid="AdminPage_Resolution" Text="{x:Bind Resolution, Mode=TwoWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Uid="AdminPage_Resolve" Command="{x:Bind ResolveCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                                                <Button x:Uid="AdminPage_Dismiss" Command="{x:Bind DismissCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                                                <Button x:Uid="AdminPage_Moderate" Command="{x:Bind ModerateCommand}" Visibility="{x:Bind CanModerateTarget}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Uid="Common_LoadMore" HorizontalAlignment="Left" Command="{x:Bind Moderation.MoreReportsCommand}" Visibility="{x:Bind Moderation.HasMoreReports, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Sperren -->
        <ScrollViewer x:Name="BansPanel" Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <ItemsControl MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" ItemsSource="{x:Bind Moderation.Bans}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModBanItemViewModel">
                        <Grid Padding="0,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <HyperlinkButton Padding="0" Command="{x:Bind OpenCommand}" Content="{x:Bind Title}" />
                                <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Uid="Ban_Lift" Grid.Column="1" Command="{x:Bind LiftCommand}" Visibility="{x:Bind CanLift}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Mod-Log -->
        <ListView x:Name="LogPanel" x:Uid="AdminPage_LogList" Grid.Row="3" ItemsSource="{x:Bind Moderation.Log}" SelectionMode="None" Visibility="Collapsed">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Padding="0,4" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Wortfilter -->
        <Grid x:Name="WordsPanel" Grid.Row="3" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Uid="AdminPage_WordPattern" Width="220" Text="{x:Bind Moderation.NewPattern, Mode=TwoWay}" />
                <ComboBox x:Uid="AdminPage_WordAction" MinWidth="160" ItemsSource="{x:Bind Moderation.WordActions}" SelectedItem="{x:Bind Moderation.NewAction, Mode=TwoWay}" />
                <TextBox x:Uid="AdminPage_WordReplacement" Width="180" Text="{x:Bind Moderation.NewReplacement, Mode=TwoWay}" />
                <Button x:Uid="AdminPage_WordAdd" VerticalAlignment="Bottom" Command="{x:Bind Moderation.AddWordCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" ItemsSource="{x:Bind Moderation.Words}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WordItemViewModel">
                            <Grid Padding="0,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontFamily="Consolas" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Pattern}" />
                                    <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                </StackPanel>
                                <Button x:Uid="Backup_Delete" Grid.Column="1" Command="{x:Bind DeleteCommand}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <!-- Galerie-Freigaben -->
        <Grid x:Name="GalleryPanel" Grid.Row="3" RowSpacing="8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="Backup_Reload" Command="{x:Bind Media.LoadGalleryCommand}" />
                <ProgressRing Width="20" Height="20" IsActive="{x:Bind Media.IsBusy, Mode=OneWay}" />
            </StackPanel>
            <TextBlock x:Uid="AdminPage_GalleryEmpty" Grid.Row="1" Style="{StaticResource RoGMutedTextStyle}" Visibility="{x:Bind Media.NoPending, Mode=OneWay}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind Media.Pending}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="12" MinItemWidth="260" MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PendingGalleryItemViewModel">
                            <Border Style="{StaticResource RoGCardStyle}" AutomationProperties.Name="{x:Bind Title}">
                                <StackPanel Spacing="8">
                                    <Button Padding="0" Command="{x:Bind OpenCommand}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind Title}">
                                        <Image Height="150" Source="{x:Bind Thumb}" Stretch="UniformToFill" />
                                    </Button>
                                    <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="Approval_Approve" Command="{x:Bind ApproveCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                                        <Button x:Uid="Approval_Reject" Command="{x:Bind RejectCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- Uploads: Meldungen und Speicher -->
        <Grid x:Name="UploadsPanel" Grid.Row="3" ColumnSpacing="24" RowSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="Backup_Reload" Command="{x:Bind Media.LoadUploadsCommand}" />
                <ProgressRing Width="20" Height="20" IsActive="{x:Bind Media.IsBusy, Mode=OneWay}" />
            </StackPanel>
            <TextBlock x:Uid="AdminPage_UploadsEmpty" Grid.Row="1" Style="{StaticResource RoGMutedTextStyle}" Visibility="{x:Bind Media.NoReports, Mode=OneWay}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind Media.Reports}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UploadReportItemViewModel">
                            <Border Margin="0,0,0,12" Style="{StaticResource RoGCardStyle}" AutomationProperties.Name="{x:Bind Title}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Padding="0" VerticalAlignment="Top" Command="{x:Bind OpenCommand}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind Title}">
                                        <Image Width="120" Height="80" Source="{x:Bind Thumb}" Stretch="UniformToFill" />
                                    </Button>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <Border Style="{StaticResource RoGAlertBadgeStyle}" Visibility="{x:Bind IsChildSafety}">
                                            <TextBlock x:Uid="AdminPage_ChildSafetyBadge" Style="{StaticResource RoGAlertBadgeTextStyle}" />
                                        </Border>
                                        <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Reason}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Uid="AdminPage_UploadKeep" Command="{x:Bind KeepCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                                            <Button x:Uid="AdminPage_UploadDelete" Command="{x:Bind DeleteCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.RowSpan="2" Grid.Column="1" Spacing="8">
                <TextBlock x:Uid="AdminPage_StorageTitle" Style="{StaticResource RoGSectionTextStyle}" />
                <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Media.StorageText, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Website-Verwaltung -->
        <ScrollViewer x:Name="WebsitePanel" Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" Spacing="12">
                <!-- In der App: allgemeiner Editor je Bereich (eigenes Fenster) -->
                <StackPanel Spacing="12" Visibility="{x:Bind Media.HasNativeAreas}">
                    <TextBlock x:Uid="AdminPage_NativeTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock x:Uid="AdminPage_NativeHint" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                    <ItemsRepeater ItemsSource="{x:Bind Media.NativeAreas}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="8" MinItemHeight="64" MinItemWidth="220" MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AdminAreaButtonViewModel">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Command="{x:Bind OpenCommand}"
                                    AutomationProperties.Name="{x:Bind Label}">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Group}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <TextBlock x:Uid="AdminPage_BrowserTitle" Margin="0,12,0,0" Style="{StaticResource RoGSectionTextStyle}" Visibility="{x:Bind Media.HasWebLinks}" />
                <TextBlock x:Uid="AdminPage_WebsiteHint" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" Visibility="{x:Bind Media.HasWebLinks}" />
                <ItemsRepeater ItemsSource="{x:Bind Media.WebLinks}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="8" MinItemWidth="220" MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdminWebLinkViewModel">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind OpenCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" ToolTipService.ToolTip="{x:Bind Address}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                    <TextBlock Text="{x:Bind Label}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
