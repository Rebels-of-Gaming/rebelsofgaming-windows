<?xml version="1.0" encoding="utf-8"?>
<!-- Herausgelöster Chat (Pflichtenheft: Chat als eigenes Fenster, optional immer im Vordergrund). -->
<Window
    x:Class="RoG.App.Views.ChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls">

    <Grid Background="{StaticResource RoGBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="TitleBar"
            Padding="16,0,140,0"
            Background="{StaticResource RoGBg2Brush}"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                FontSize="14"
                CharacterSpacing="60"
                Foreground="{StaticResource RoGMutedBrush}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
        <ToggleButton
            x:Name="OnTopToggle"
            x:Uid="ChatWindow_OnTop"
            Margin="0,4,140,4"
            Padding="8,4"
            HorizontalAlignment="Right"
            Checked="OnTopChanged"
            Unchecked="OnTopChanged">
            <FontIcon FontSize="14" Glyph="&#xE718;" />
        </ToggleButton>
        <controls:ChatView x:Name="Chat" Grid.Row="1" />
    </Grid>
</Window>
