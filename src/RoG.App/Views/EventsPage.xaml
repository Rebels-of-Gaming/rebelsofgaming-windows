<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.EventsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <controls:ListDetailPanel DetailClosed="OnDetailClosed" IsDetailOpen="{x:Bind ViewModel.IsDetailOpen, Mode=OneWay}">
        <controls:ListDetailPanel.List>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="24,24,24,12" ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <SelectorBar Grid.Row="1" Grid.ColumnSpan="2" SelectionChanged="OnViewModeChanged">
                        <SelectorBarItem x:Uid="EventsPage_ModeList" IsSelected="True" />
                        <SelectorBarItem x:Uid="EventsPage_ModeMonth" />
                    </SelectorBar>
                    <TextBlock
                        x:Uid="EventsPage_Title"
                        Style="{StaticResource RoGDisplayTextStyle}"
                        Text="TERMINE" />
                    <Button x:Uid="EventsPage_New" Grid.Column="1" VerticalAlignment="Center" Click="OnNewEventClick" Style="{StaticResource RoGPrimaryButtonStyle}" Visibility="{x:Bind ViewModel.CanManage}" />
                </Grid>
                <controls:StateView
                    x:Uid="EventsPage_State"
                    Grid.Row="1"
                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
                <ListView
                    x:Uid="EventsPage_List"
                    Grid.Row="1"
                    Padding="12,0,12,12"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.ShowList, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EventRowViewModel">
                            <StackPanel Opacity="{x:Bind Opacity}" AutomationProperties.Name="{x:Bind Title}">
                                <TextBlock
                                    Margin="0,12,0,4"
                                    FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                                    FontSize="13"
                                    CharacterSpacing="60"
                                    Foreground="{StaticResource RoGMutedBrush}"
                                    Text="{x:Bind DayHeader}"
                                    Visibility="{x:Bind ShowDayHeader}" />
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="{x:Bind TypeBrush}" RadiusX="2" RadiusY="2" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource RoGBodyTextStyle}"
                                        Text="{x:Bind Time}" />
                                    <StackPanel Grid.Column="2" Spacing="1">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{StaticResource RoGBodyTextStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            MaxLines="1"
                                            Style="{StaticResource RoGMutedTextStyle}"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource RoGGreenBrush}"
                                            Text="{x:Bind RsvpText}"
                                            Visibility="{x:Bind HasRsvp}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Monatsansicht -->
                <ScrollViewer Grid.Row="1" Padding="12,0,12,12" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.MonthMode, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Uid="EventsPage_PrevMonth" Command="{x:Bind ViewModel.PreviousMonthCommand}"><FontIcon FontSize="12" Glyph="&#xE76B;" /></Button>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource RoGSectionTextStyle}" Text="{x:Bind ViewModel.MonthTitle, Mode=OneWay}" />
                            <Button x:Uid="EventsPage_NextMonth" Grid.Column="2" Command="{x:Bind ViewModel.NextMonthCommand}"><FontIcon FontSize="12" Glyph="&#xE76C;" /></Button>
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.WeekdayNames}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout ItemsStretch="Fill" MaximumRowsOrColumns="7" MinItemWidth="36" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock HorizontalAlignment="Center" FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.MonthDays}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout ItemsStretch="Fill" MaximumRowsOrColumns="7" MinColumnSpacing="2" MinItemHeight="44" MinItemWidth="36" MinRowSpacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonthDayViewModel">
                                    <Button
                                        Padding="2"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        BorderBrush="{x:Bind CellBorder}"
                                        Command="{x:Bind SelectCommand}"
                                        Opacity="{x:Bind Opacity}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Number}" />
                                            <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource RoGRedBrush}" Text="{x:Bind Dots}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource RoGSectionTextStyle}" Text="{x:Bind ViewModel.DayTitle, Mode=OneWay}" />
                        <!-- Klick statt SelectedItem-Bindung: die Liste enthält den gewählten Termin oft nicht und würde die Auswahl sonst leeren -->
                        <ListView IsItemClickEnabled="True" ItemClick="OnDayEventClick" ItemsSource="{x:Bind ViewModel.DayEvents}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:EventRowViewModel">
                                    <StackPanel Padding="0,4" AutomationProperties.Name="{x:Bind Title}">
                                        <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Time}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </controls:ListDetailPanel.List>

        <!-- Termin -->
        <Grid>
            <TextBlock
                x:Uid="EventsPage_SelectHint"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource RoGMutedTextStyle}"
                Visibility="{x:Bind ViewModel.ShowSelectHint, Mode=OneWay}" />
            <controls:StateView
                ErrorMessage="{x:Bind ViewModel.Detail.ErrorMessage, Mode=OneWay}"
                IsLoading="{x:Bind ViewModel.Detail.IsLoading, Mode=OneWay}"
                RetryCommand="{x:Bind ViewModel.Detail.RefreshCommand}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.Detail.ShowContent, Mode=OneWay}">
                <StackPanel
                    MaxWidth="{StaticResource RoGReadingWidth}"
                    Padding="32,24,32,32"
                    HorizontalAlignment="Left"
                    Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                            FontSize="14"
                            CharacterSpacing="60"
                            Foreground="{x:Bind ViewModel.Detail.TypeBrush, Mode=OneWay}"
                            Text="{x:Bind ViewModel.Detail.TypeLabel, Mode=OneWay}" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource RoGTitleTextStyle}"
                            Text="{x:Bind ViewModel.Detail.Title, Mode=OneWay}"
                            AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Detail.When, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Detail.Where, Mode=OneWay}" />
                        <TextBlock Foreground="{StaticResource RoGGoldBrush}" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Detail.Flags, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Detail.Counts, Mode=OneWay}" />
                    </StackPanel>

                    <InfoBar
                        IsOpen="{x:Bind ViewModel.Detail.IsFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.Detail.FeedbackMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.Detail.FeedbackSeverity, Mode=OneWay}" />

                    <!-- Zusage -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Detail.CanRespond, Mode=OneWay}">
                        <TextBlock x:Uid="EventsPage_Rsvp" Style="{StaticResource RoGSectionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton
                                x:Uid="EventsPage_Yes"
                                Command="{x:Bind ViewModel.Detail.RespondYesCommand}"
                                IsChecked="{x:Bind ViewModel.Detail.IsYes, Mode=OneWay}" />
                            <ToggleButton
                                x:Uid="EventsPage_Maybe"
                                Command="{x:Bind ViewModel.Detail.RespondMaybeCommand}"
                                IsChecked="{x:Bind ViewModel.Detail.IsMaybe, Mode=OneWay}" />
                            <ToggleButton
                                x:Uid="EventsPage_No"
                                Command="{x:Bind ViewModel.Detail.RespondNoCommand}"
                                IsChecked="{x:Bind ViewModel.Detail.IsNo, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="EventsPage_AddToCalendar"
                            Command="{x:Bind ViewModel.Detail.AddToCalendarCommand}"
                            Style="{StaticResource RoGSecondaryButtonStyle}" />
                        <Button
                            x:Uid="Common_OpenInBrowser"
                            Command="{x:Bind ViewModel.Detail.OpenInBrowserCommand}"
                            Style="{StaticResource RoGSecondaryButtonStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Detail.CanManage}">
                        <Button x:Uid="EventsPage_Cancel" Command="{x:Bind ViewModel.Detail.CancelEventCommand}" />
                        <Button x:Uid="EventsPage_Delete" Command="{x:Bind ViewModel.Detail.DeleteEventCommand}" />
                    </StackPanel>

                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Detail.Description, Mode=OneWay}" />

                    <!-- Teilnehmer -->
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Detail.HasParticipants, Mode=OneWay}">
                        <TextBlock x:Uid="EventsPage_Participants" Style="{StaticResource RoGSectionTextStyle}" />
                        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Detail.ParticipantsText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Aufstellung -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Detail.HasLineup, Mode=OneWay}">
                        <TextBlock x:Uid="EventsPage_Lineup" Style="{StaticResource RoGSectionTextStyle}" />
                        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Detail.LineupText, Mode=OneWay}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Detail.CanEditLineup, Mode=OneWay}">
                            <Button x:Uid="EventsPage_EditLineup" Click="OnEditLineupClick" Style="{StaticResource RoGSecondaryButtonStyle}" />
                            <Button x:Uid="EventsPage_UnpublishLineup" Command="{x:Bind ViewModel.Detail.UnpublishLineupCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <controls:ServerCard Item="{x:Bind ViewModel.Detail.Server, Mode=OneWay}" Visibility="{x:Bind ViewModel.Detail.HasServer, Mode=OneWay}" />

                    <controls:SocialStatusCard Status="{x:Bind ViewModel.Detail.Social}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </controls:ListDetailPanel>
</Page>
