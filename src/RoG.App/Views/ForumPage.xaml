<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.ForumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <controls:ListDetailPanel DetailClosed="OnDetailClosed" IsDetailOpen="{x:Bind ViewModel.IsDetailOpen, Mode=OneWay}">
        <controls:ListDetailPanel.List>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Uid="ForumPage_Title"
                    Margin="24,24,24,12"
                    Style="{StaticResource RoGDisplayTextStyle}"
                    Text="FORUM" />
                <controls:StateView
                    x:Uid="ForumPage_State"
                    Grid.Row="1"
                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    RetryCommand="{x:Bind ViewModel.RefreshCommand}" />

                <!-- Bereiche -->
                <ListView
                    x:Name="CategoryList"
                    x:Uid="ForumPage_Categories"
                    Grid.Row="1"
                    Padding="12,0,12,12"
                    IsItemClickEnabled="True"
                    ItemClick="OnCategoryClick"
                    ItemsSource="{x:Bind ViewModel.Categories}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.ShowCategories, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryItemViewModel">
                            <StackPanel Margin="{x:Bind Indent}" Padding="0,8" Spacing="2" AutomationProperties.Name="{x:Bind Name}">
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    FontSize="12"
                                    MaxLines="2"
                                    Style="{StaticResource RoGMutedTextStyle}"
                                    Text="{x:Bind Description}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind HasDescription}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource RoGGoldBrush}" Text="{x:Bind Stats}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Themen eines Bereichs -->
                <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.ShowThreads, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,0,16,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Uid="ForumPage_Back" Command="{x:Bind ViewModel.BackToCategoriesCommand}" Style="{StaticResource RoGSecondaryButtonStyle}">
                            <FontIcon FontSize="14" Glyph="&#xE72B;" />
                        </Button>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource RoGSectionTextStyle}"
                            Text="{x:Bind ViewModel.Category.Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Uid="ForumPage_NewThread"
                            Grid.Column="2"
                            Click="OnNewThreadClick"
                            Style="{StaticResource RoGPrimaryButtonStyle}"
                            Visibility="{x:Bind ViewModel.CanCreateThread, Mode=OneWay}" />
                    </Grid>
                    <ProgressRing
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsLoadingThreads, Mode=OneWay}" />
                    <ListView
                        x:Uid="ForumPage_Threads"
                        Grid.Row="1"
                        Padding="12,0,12,12"
                        ItemsSource="{x:Bind ViewModel.Threads}"
                        SelectedItem="{x:Bind ViewModel.SelectedThread, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThreadItemViewModel">
                                <Grid Padding="0,8" ColumnSpacing="10" AutomationProperties.Name="{x:Bind Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Top"
                                        Fill="{x:Bind UnreadBrush, Mode=OneWay}"
                                        Style="{StaticResource RoGStatusDotStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            FontWeight="{x:Bind TitleWeight, Mode=OneWay}"
                                            MaxLines="2"
                                            Style="{StaticResource RoGBodyTextStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock FontSize="12" Text="{x:Bind Badges}" Visibility="{x:Bind HasBadges}" />
                                            <TextBlock
                                                FontSize="12"
                                                MaxLines="1"
                                                Style="{StaticResource RoGMutedTextStyle}"
                                                Text="{x:Bind Meta}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.Footer>
                            <Button
                                x:Uid="Common_LoadMore"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.LoadMoreThreadsCommand}"
                                Style="{StaticResource RoGSecondaryButtonStyle}"
                                Visibility="{x:Bind ViewModel.HasMoreThreads, Mode=OneWay}" />
                        </ListView.Footer>
                    </ListView>
                </Grid>
            </Grid>
        </controls:ListDetailPanel.List>

        <!-- Thema -->
        <Grid>
            <TextBlock
                x:Uid="ForumPage_SelectHint"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource RoGMutedTextStyle}"
                Visibility="{x:Bind ViewModel.ShowSelectHint, Mode=OneWay}" />
            <controls:StateView
                ErrorMessage="{x:Bind ViewModel.Thread.ErrorMessage, Mode=OneWay}"
                IsLoading="{x:Bind ViewModel.Thread.IsLoading, Mode=OneWay}"
                RetryCommand="{x:Bind ViewModel.Thread.RefreshCommand}" />
            <ScrollViewer x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.Thread.ShowContent, Mode=OneWay}">
                <StackPanel
                    MaxWidth="{StaticResource RoGReadingWidth}"
                    Padding="32,24,32,32"
                    HorizontalAlignment="Left"
                    Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource RoGTitleTextStyle}"
                            Text="{x:Bind ViewModel.Thread.Title, Mode=OneWay}"
                            AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Thread.Meta, Mode=OneWay}" />
                    </StackPanel>

                    <InfoBar
                        IsOpen="{x:Bind ViewModel.Thread.IsFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.Thread.FeedbackMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.Thread.FeedbackSeverity, Mode=OneWay}" />

                    <!-- Umfrage -->
                    <Border Style="{StaticResource RoGCardStyle}" Visibility="{x:Bind ViewModel.Thread.HasPoll, Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Thread.PollQuestion, Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Thread.PollOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PollOptionViewModel">
                                        <Grid Margin="0,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Label}" />
                                                <ProgressBar Maximum="100" Value="{x:Bind Percent}" />
                                            </StackPanel>
                                            <Button
                                                x:Uid="ForumPage_Vote"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Command="{x:Bind VoteCommand}"
                                                ToolTipService.ToolTip="{x:Bind Votes}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Thread.PollMeta, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Beiträge -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Thread.Posts}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:PostViewModel">
                                <Border Style="{StaticResource RoGCardStyle}" AutomationProperties.Name="{x:Bind Author}">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource RoGGoldBrush}" Text="{x:Bind Author}" />
                                            <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                        <Button
                                            x:Uid="ForumPage_Reveal"
                                            Command="{x:Bind RevealCommand}"
                                            Visibility="{x:Bind IsCollapsed, Mode=OneWay}" />
                                        <controls:RichContentView Document="{x:Bind Content, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="12"
                                            Style="{StaticResource RoGMutedTextStyle}"
                                            Text="{x:Bind Attachments}"
                                            Visibility="{x:Bind HasAttachments}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ItemsControl ItemsSource="{x:Bind Reactions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ReactionChipViewModel">
                                                        <Button
                                                            Padding="8,2"
                                                            BorderBrush="{x:Bind BorderBrush}"
                                                            BorderThickness="1"
                                                            Command="{x:Bind ToggleCommand}"
                                                            Content="{x:Bind Text}"
                                                            CornerRadius="12" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <DropDownButton x:Uid="ForumPage_React" Padding="8,2" Visibility="{x:Bind CanInteract}">
                                                <FontIcon FontSize="14" Glyph="&#xE76E;" />
                                                <DropDownButton.Flyout>
                                                    <Flyout>
                                                        <ItemsControl ItemsSource="{x:Bind ReactionChoices}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ReactionChoiceViewModel">
                                                                    <Button
                                                                        Margin="0,2"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left"
                                                                        Command="{x:Bind ChooseCommand}"
                                                                        Content="{x:Bind Text}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Flyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                            <Button
                                                x:Uid="ForumPage_Quote"
                                                Padding="8,2"
                                                Command="{x:Bind QuoteCommand}"
                                                Visibility="{x:Bind CanInteract}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button
                        x:Uid="Common_LoadMore"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.Thread.LoadMorePostsCommand}"
                        Style="{StaticResource RoGSecondaryButtonStyle}"
                        Visibility="{x:Bind ViewModel.Thread.HasMorePosts, Mode=OneWay}" />

                    <!-- Antworten -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Thread.CanReply, Mode=OneWay}">
                        <TextBlock x:Uid="ForumPage_ReplyTitle" Style="{StaticResource RoGSectionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Uid="ForumPage_Bold" Click="OnFormatClick" Tag="b"><FontIcon FontSize="14" Glyph="&#xE8DD;" /></Button>
                            <Button x:Uid="ForumPage_Italic" Click="OnFormatClick" Tag="i"><FontIcon FontSize="14" Glyph="&#xE8DB;" /></Button>
                            <Button x:Uid="ForumPage_Underline" Click="OnFormatClick" Tag="u"><FontIcon FontSize="14" Glyph="&#xE8DC;" /></Button>
                            <Button x:Uid="ForumPage_QuoteTag" Click="OnFormatClick" Tag="quote"><FontIcon FontSize="14" Glyph="&#xE9B2;" /></Button>
                            <Button x:Uid="ForumPage_Code" Click="OnFormatClick" Tag="code"><FontIcon FontSize="14" Glyph="&#xE943;" /></Button>
                            <Button x:Uid="ForumPage_Spoiler" Click="OnFormatClick" Tag="spoiler"><FontIcon FontSize="14" Glyph="&#xE7B3;" /></Button>
                            <Button x:Uid="ForumPage_Link" Click="OnFormatClick" Tag="url"><FontIcon FontSize="14" Glyph="&#xE71B;" /></Button>
                        </StackPanel>
                        <TextBox
                            x:Name="ReplyBox"
                            x:Uid="ForumPage_ReplyBox"
                            MinHeight="120"
                            MaxHeight="320"
                            AcceptsReturn="True"
                            Text="{x:Bind ViewModel.Thread.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap">
                            <TextBox.KeyboardAccelerators>
                                <KeyboardAccelerator
                                    Key="Enter"
                                    Invoked="OnSendInvoked"
                                    Modifiers="Control" />
                            </TextBox.KeyboardAccelerators>
                        </TextBox>
                        <Border Style="{StaticResource RoGCardStyle}" Visibility="{x:Bind ViewModel.Thread.ShowPreview, Mode=OneWay}">
                            <controls:RichContentView Document="{x:Bind ViewModel.Thread.PreviewDocument, Mode=OneWay}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="ForumPage_Send"
                                Command="{x:Bind ViewModel.Thread.SendCommand}"
                                Style="{StaticResource RoGPrimaryButtonStyle}" />
                            <Button
                                x:Uid="ForumPage_Preview"
                                Command="{x:Bind ViewModel.Thread.TogglePreviewCommand}"
                                Style="{StaticResource RoGSecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </controls:ListDetailPanel>
</Page>
