<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource RoGPagePadding}" Spacing="20">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="HomePage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="START" />
                    <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" />
                </StackPanel>
                <Button
                    x:Uid="HomePage_Refresh"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource RoGSecondaryButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>

            <InfoBar
                x:Name="GuestHint"
                x:Uid="HomePage_GuestHint"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsGuest, Mode=OneWay}"
                Severity="Informational" />

            <Button
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.OpenVotesCommand}"
                Content="{x:Bind ViewModel.VotesText, Mode=OneWay}"
                Style="{StaticResource RoGPrimaryButtonStyle}"
                Visibility="{x:Bind ViewModel.HasVotes, Mode=OneWay}" />

            <TextBlock x:Uid="HomePage_LiveTitle" Style="{StaticResource RoGSectionTextStyle}" />

            <ProgressRing
                x:Uid="HomePage_Loading"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Warning" />

            <TextBlock
                x:Uid="HomePage_LiveEmpty"
                Style="{StaticResource RoGMutedTextStyle}"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

            <!-- Live-Ticker: Kacheln verteilen sich auf die Fensterbreite -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Stats}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemWidth="200"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:LiveStatItem">
                        <Border AutomationProperties.Name="{x:Bind AutomationName}" Style="{StaticResource RoGCardStyle}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{x:Bind ToneBrush}"
                                        Glyph="{x:Bind Glyph}"
                                        AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock
                                        Style="{StaticResource RoGSectionTextStyle}"
                                        Text="{x:Bind Label}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource RoGTitleTextStyle}" Text="{x:Bind Value}" />
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource RoGMutedTextStyle}"
                                    Text="{x:Bind Hint}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind HasHint}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Neueste News und nächste Termine -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource RoGCardStyle}" Visibility="{x:Bind ViewModel.HasNews, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="HomePage_NewsTitle" Style="{StaticResource RoGSectionTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.LatestNews}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeLinkItem">
                                    <Button
                                        Padding="8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind OpenCommand}"
                                        AutomationProperties.Name="{x:Bind Title}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource RoGCardStyle}" Visibility="{x:Bind ViewModel.HasEvents, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="HomePage_EventsTitle" Style="{StaticResource RoGSectionTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.NextEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeLinkItem">
                                    <Button
                                        Padding="8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind OpenCommand}"
                                        AutomationProperties.Name="{x:Bind Title}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                MaxWidth="{StaticResource RoGReadingWidth}"
                HorizontalAlignment="Left"
                Style="{StaticResource RoGCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="HomePage_ComingSoonTitle" Style="{StaticResource RoGSectionTextStyle}" Text="IM AUFBAU" />
                    <TextBlock x:Uid="HomePage_ComingSoonText" Style="{StaticResource RoGBodyTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
