<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <controls:ListDetailPanel DetailClosed="OnDetailClosed" IsDetailOpen="{x:Bind ViewModel.IsDetailOpen, Mode=OneWay}">
        <controls:ListDetailPanel.List>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Uid="InfoPage_Title"
                    Margin="24,24,24,12"
                    Style="{StaticResource RoGDisplayTextStyle}"
                    Text="INFO" />
                <controls:StateView
                    x:Uid="InfoPage_State"
                    Grid.Row="1"
                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
                <ListView
                    x:Uid="InfoPage_List"
                    Grid.Row="1"
                    Padding="12,0,12,12"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:InfoItemViewModel">
                            <StackPanel AutomationProperties.Name="{x:Bind Title}">
                                <TextBlock
                                    Margin="0,12,0,4"
                                    FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                                    FontSize="13"
                                    CharacterSpacing="60"
                                    Foreground="{StaticResource RoGMutedBrush}"
                                    Text="{x:Bind GroupHeader}"
                                    Visibility="{x:Bind ShowGroupHeader}" />
                                <StackPanel Padding="0,6" Spacing="1">
                                    <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" />
                                    <TextBlock
                                        FontSize="12"
                                        MaxLines="2"
                                        Style="{StaticResource RoGMutedTextStyle}"
                                        Text="{x:Bind Subtitle}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind HasSubtitle}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource RoGRedBrush}"
                                        Text="{x:Bind AcceptanceText}"
                                        Visibility="{x:Bind NeedsAcceptance}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </controls:ListDetailPanel.List>

        <Grid>
            <TextBlock
                x:Uid="InfoPage_SelectHint"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource RoGMutedTextStyle}"
                Visibility="{x:Bind ViewModel.ShowSelectHint, Mode=OneWay}" />
            <controls:StateView
                ErrorMessage="{x:Bind ViewModel.Detail.ErrorMessage, Mode=OneWay}"
                IsLoading="{x:Bind ViewModel.Detail.IsLoading, Mode=OneWay}"
                RetryCommand="{x:Bind ViewModel.Detail.RefreshCommand}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.Detail.ShowContent, Mode=OneWay}">
                <StackPanel
                    MaxWidth="{StaticResource RoGReadingWidth}"
                    Padding="32,24,32,32"
                    HorizontalAlignment="Left"
                    Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource RoGTitleTextStyle}"
                            Text="{x:Bind ViewModel.Detail.Title, Mode=OneWay}"
                            AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Detail.Meta, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Detail.Intro, Mode=OneWay}" />

                    <InfoBar
                        IsOpen="{x:Bind ViewModel.Detail.IsFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.Detail.FeedbackMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.Detail.FeedbackSeverity, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="InfoPage_Accept"
                            Command="{x:Bind ViewModel.Detail.AcceptCommand}"
                            Style="{StaticResource RoGPrimaryButtonStyle}"
                            Visibility="{x:Bind ViewModel.Detail.CanAccept, Mode=OneWay}" />
                        <Button
                            x:Uid="Common_OpenInBrowser"
                            Command="{x:Bind ViewModel.Detail.OpenInBrowserCommand}"
                            Style="{StaticResource RoGSecondaryButtonStyle}"
                            Visibility="{x:Bind ViewModel.Detail.HasWebUrl, Mode=OneWay}" />
                    </StackPanel>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Sections}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="20" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:InfoSectionViewModel">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Foreground="{x:Bind TitleBrush}"
                                        Style="{StaticResource RoGSectionTextStyle}"
                                        Text="{x:Bind Title}"
                                        Visibility="{x:Bind HasTitle}"
                                        AutomationProperties.HeadingLevel="Level2" />
                                    <controls:RichContentView Document="{x:Bind Content}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </controls:ListDetailPanel>
</Page>
