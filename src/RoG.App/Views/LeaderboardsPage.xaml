<?xml version="1.0" encoding="utf-8"?>
<!-- Minecraft-Bestenlisten (Website v0.41.0): nur Mitglieder mit freigegebenen Statistiken. -->
<Page
    x:Class="RoG.App.Views.LeaderboardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="{StaticResource RoGPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="8">
            <TextBlock x:Uid="LeaderboardsPage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="BESTENLISTEN" />
            <TextBlock x:Uid="LeaderboardsPage_Intro" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <VariableSizedWrapGrid ItemHeight="72" ItemWidth="212" Orientation="Horizontal">
                <ComboBox
                    x:Uid="LeaderboardsPage_Board"
                    Width="200"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.BoardOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedBoard, Mode=TwoWay}" />
                <ComboBox
                    x:Uid="LeaderboardsPage_Period"
                    Width="200"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.PeriodOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedPeriod, Mode=TwoWay}" />
                <ComboBox
                    x:Uid="LeaderboardsPage_Sort"
                    Width="200"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.HasSorts, Mode=OneWay}" />
                <ComboBox
                    x:Uid="LeaderboardsPage_Course"
                    Width="200"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.CourseOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedCourse, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.HasCourses, Mode=OneWay}" />
            </VariableSizedWrapGrid>
            <TextBlock
                FontSize="12"
                Style="{StaticResource RoGMutedTextStyle}"
                Text="{x:Bind ViewModel.Hint, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasHint, Mode=OneWay}" />
        </StackPanel>

        <controls:StateView
            x:Uid="LeaderboardsPage_State"
            Grid.Row="2"
            ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
            IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
        <ListView
            x:Uid="LeaderboardsPage_List"
            Grid.Row="2"
            MaxWidth="720"
            HorizontalAlignment="Left"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LeaderboardEntryViewModel">
                    <Grid Padding="0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind RankBrush}"
                            Style="{StaticResource RoGBodyTextStyle}"
                            Text="{x:Bind RankText}" />
                        <PersonPicture
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            DisplayName="{x:Bind Name}"
                            ProfilePicture="{x:Bind Avatar}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Style="{StaticResource RoGMutedTextStyle}"
                                Text="{x:Bind Meta}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind HasMeta}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Style="{StaticResource RoGBodyTextStyle}"
                            Text="{x:Bind ValueText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
