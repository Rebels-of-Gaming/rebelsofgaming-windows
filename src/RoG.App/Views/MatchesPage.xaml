<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.MatchesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,24,24,8" Spacing="12">
            <TextBlock x:Uid="MatchesPage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="MATCHES" />
            <SelectorBar x:Name="TabBar" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Uid="MatchesPage_TabMatches" IsSelected="True" />
                <SelectorBarItem x:Uid="MatchesPage_TabHall" />
                <SelectorBarItem x:Uid="MatchesPage_TabStats" />
            </SelectorBar>
        </StackPanel>

        <!-- Matches -->
        <controls:ListDetailPanel
            x:Name="MatchesPanel"
            Grid.Row="1"
            DetailClosed="OnDetailClosed"
            IsDetailOpen="{x:Bind ViewModel.IsDetailOpen, Mode=OneWay}">
            <controls:ListDetailPanel.List>
                <Grid>
                    <controls:StateView
                        x:Uid="MatchesPage_State"
                        ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                        IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
                    <ListView
                        x:Uid="MatchesPage_List"
                        Padding="12,0,12,12"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MatchRowViewModel">
                                <Grid Padding="0,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="{x:Bind ResultBrush}" RadiusX="2" RadiusY="2" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{StaticResource RoGBodyTextStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            MaxLines="1"
                                            Style="{StaticResource RoGMutedTextStyle}"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource RoGDisplayFont}"
                                        FontSize="22"
                                        Foreground="{x:Bind ResultBrush}"
                                        Text="{x:Bind Score}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.Footer>
                            <Button
                                x:Uid="Common_LoadMore"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.LoadMoreCommand}"
                                Style="{StaticResource RoGSecondaryButtonStyle}"
                                Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
                        </ListView.Footer>
                    </ListView>
                </Grid>
            </controls:ListDetailPanel.List>

            <Grid>
                <TextBlock
                    x:Uid="MatchesPage_SelectHint"
                    Margin="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource RoGMutedTextStyle}"
                    Visibility="{x:Bind ViewModel.ShowSelectHint, Mode=OneWay}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel
                        MaxWidth="{StaticResource RoGReadingWidth}"
                        Padding="32,24,32,32"
                        HorizontalAlignment="Left"
                        Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource RoGTitleTextStyle}"
                                Text="{x:Bind ViewModel.Selected.Title, Mode=OneWay}"
                                AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Selected.Subtitle, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                FontFamily="{StaticResource RoGDisplayFont}"
                                FontSize="48"
                                Foreground="{x:Bind ViewModel.Selected.ResultBrush, Mode=OneWay}"
                                Text="{x:Bind ViewModel.Selected.Score, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{x:Bind ViewModel.Selected.ResultBrush, Mode=OneWay}"
                                Style="{StaticResource RoGSectionTextStyle}"
                                Text="{x:Bind ViewModel.Selected.ResultText, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Selected.HasMaps, Mode=OneWay}">
                            <TextBlock x:Uid="MatchesPage_Maps" Style="{StaticResource RoGSectionTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Selected.Maps, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MatchMapRow">
                                        <Grid Padding="0,4" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Map}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontWeight="SemiBold"
                                                Foreground="{x:Bind ResultBrush}"
                                                Text="{x:Bind Score}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Selected.HasLineup, Mode=OneWay}">
                            <TextBlock x:Uid="MatchesPage_Lineup" Style="{StaticResource RoGSectionTextStyle}" />
                            <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Selected.Lineup, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Selected.HasLinks, Mode=OneWay}">
                            <TextBlock x:Uid="SquadsPage_Links" Style="{StaticResource RoGSectionTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Selected.Links, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LinkViewModel">
                                        <HyperlinkButton Command="{x:Bind OpenCommand}" Content="{x:Bind Label}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </controls:ListDetailPanel>

        <!-- Hall of Fame -->
        <Grid
            x:Name="HallPanel"
            Grid.Row="1"
            Visibility="Collapsed">
            <controls:StateView
                ErrorMessage="{x:Bind ViewModel.Hall.ErrorMessage, Mode=OneWay}"
                IsEmpty="{x:Bind ViewModel.Hall.IsEmpty, Mode=OneWay}"
                IsLoading="{x:Bind ViewModel.Hall.IsLoading, Mode=OneWay}"
                RetryCommand="{x:Bind ViewModel.Hall.RefreshCommand}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.Hall.ShowContent, Mode=OneWay}">
                <StackPanel Padding="24,8,24,32" Spacing="20">
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Hall.HasTrophies, Mode=OneWay}">
                        <TextBlock x:Uid="MatchesPage_Trophies" Style="{StaticResource RoGSectionTextStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Hall.Trophies}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="16" MinItemWidth="260" MinRowSpacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:HallEntryViewModel">
                                    <Border Style="{StaticResource RoGCardStyle}" AutomationProperties.Name="{x:Bind Title}">
                                        <StackPanel Spacing="6">
                                            <FontIcon
                                                HorizontalAlignment="Left"
                                                FontSize="24"
                                                Foreground="{x:Bind MedalBrush}"
                                                Glyph="&#xE734;"
                                                AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" />
                                            <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                            <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Description}" Visibility="{x:Bind HasDescription}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Hall.HasMilestones, Mode=OneWay}">
                        <TextBlock x:Uid="MatchesPage_Milestones" Style="{StaticResource RoGSectionTextStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Hall.Milestones}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="16" MinItemWidth="260" MinRowSpacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:HallEntryViewModel">
                                    <Border Style="{StaticResource RoGCardStyle}" AutomationProperties.Name="{x:Bind Title}">
                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" />
                                            <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                            <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Description}" Visibility="{x:Bind HasDescription}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Hall.HasHonorary, Mode=OneWay}">
                        <TextBlock x:Uid="MatchesPage_Honorary" Style="{StaticResource RoGSectionTextStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Hall.Honorary}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="16" MinItemWidth="300" MinRowSpacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:HonoraryViewModel">
                                    <Border Style="{StaticResource RoGCardStyle}" AutomationProperties.Name="{x:Bind Name}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <PersonPicture
                                                Width="56"
                                                Height="56"
                                                VerticalAlignment="Top"
                                                DisplayName="{x:Bind Name}"
                                                ProfilePicture="{x:Bind Avatar}"
                                                AutomationProperties.AccessibilityView="Raw" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Foreground="{StaticResource RoGGoldBrush}" Style="{StaticResource RoGSectionTextStyle}" Text="{x:Bind Name}" />
                                                <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Period}" />
                                                <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Tribute}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <!-- Statistiken -->
        <Grid x:Name="StatsPanel" Grid.Row="1" Padding="24,0,24,24" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Uid="Stats_Game" MinWidth="180" ItemsSource="{x:Bind Stats.Games}" SelectedItem="{x:Bind Stats.SelectedGame, Mode=TwoWay}" />
                <ComboBox x:Uid="Stats_Period" MinWidth="140" ItemsSource="{x:Bind Stats.Periods}" SelectedItem="{x:Bind Stats.SelectedPeriod, Mode=TwoWay}" />
                <ComboBox x:Uid="Stats_Metric" MinWidth="140" ItemsSource="{x:Bind Stats.Metrics}" SelectedItem="{x:Bind Stats.SelectedMetric, Mode=TwoWay}" />
            </StackPanel>
            <controls:StateView
                x:Uid="Stats_State"
                Grid.Row="1"
                ErrorMessage="{x:Bind Stats.ErrorMessage, Mode=OneWay}"
                IsEmpty="{x:Bind Stats.IsEmpty, Mode=OneWay}"
                IsLoading="{x:Bind Stats.IsLoading, Mode=OneWay}"
                RetryCommand="{x:Bind Stats.RefreshCommand}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind Stats.ShowContent, Mode=OneWay}">
                <StackPanel MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" Spacing="16">
                    <TextBlock Foreground="{StaticResource RoGGoldBrush}" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Stats.MyRankText, Mode=OneWay}" Visibility="{x:Bind Stats.HasMyRank, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind Stats.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LeaderboardRowViewModel">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource RoGGoldBrush}" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Rank}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Name}" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Details}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource RoGSectionTextStyle}" Text="{x:Bind Stats.AwardsTitle, Mode=OneWay}" Visibility="{x:Bind Stats.HasAwards, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind Stats.Awards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AwardRowViewModel">
                                <StackPanel Padding="0,4">
                                    <TextBlock Foreground="{StaticResource RoGGoldBrush}" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Label}" />
                                    <TextBlock Style="{StaticResource RoGBodyTextStyle}">
                                        <Run Text="{x:Bind Members}" /><Run Text=" · " /><Run Text="{x:Bind Value}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
