<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.MediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Grid>
        <Grid Padding="{StaticResource RoGPagePadding}" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Uid="MediaPage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="MEDIEN" />
            <SelectorBar Grid.Row="1" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Uid="MediaPage_TabGallery" IsSelected="True" />
                <SelectorBarItem x:Uid="MediaPage_TabDownloads" />
            </SelectorBar>

            <!-- Galerie -->
            <Grid x:Name="GalleryPanel" Grid.Row="2" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.ShowItems, Mode=OneWay}">
                    <Button x:Uid="MediaPage_BackToAlbums" Command="{x:Bind ViewModel.BackToAlbumsCommand}" Style="{StaticResource RoGSecondaryButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource RoGSectionTextStyle}" Text="{x:Bind ViewModel.Album.Title, Mode=OneWay}" />
                </StackPanel>
                <controls:StateView
                    x:Uid="MediaPage_GalleryState"
                    Grid.Row="1"
                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.ShowAlbums, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Albums}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="16" MinItemWidth="240" MinRowSpacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlbumItemViewModel">
                                <Button
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="{StaticResource RoGBg2Brush}"
                                    Click="OnAlbumClick"
                                    CornerRadius="{StaticResource RoGCardRadius}"
                                    Tag="{x:Bind}"
                                    AutomationProperties.Name="{x:Bind Title}">
                                    <StackPanel>
                                        <Grid Height="140" Background="{StaticResource RoGBg3Brush}">
                                            <Image Source="{x:Bind Cover}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                                        </Grid>
                                        <StackPanel Padding="12" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
                <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoadingItems, Mode=OneWay}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.ShowItems, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="8" MinItemWidth="180" MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:GalleryItemViewModel">
                                <Button
                                    Height="150"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    Background="{StaticResource RoGBg3Brush}"
                                    Click="OnItemClick"
                                    CornerRadius="{StaticResource RoGControlRadius}"
                                    Tag="{x:Bind}"
                                    AutomationProperties.Name="{x:Bind AutomationName}">
                                    <Grid>
                                        <Image Source="{x:Bind Thumb}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="32"
                                            Glyph="&#xE768;"
                                            Visibility="{x:Bind IsVideo}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>

            <!-- Downloads -->
            <Grid x:Name="DownloadsPanel" Grid.Row="2" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar
                    IsOpen="{x:Bind ViewModel.Downloads.IsFeedbackOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.Downloads.FeedbackMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.Downloads.FeedbackSeverity, Mode=OneWay}" />
                <controls:StateView
                    x:Uid="MediaPage_DownloadsState"
                    Grid.Row="1"
                    ErrorMessage="{x:Bind ViewModel.Downloads.ErrorMessage, Mode=OneWay}"
                    IsEmpty="{x:Bind ViewModel.Downloads.IsEmpty, Mode=OneWay}"
                    IsLoading="{x:Bind ViewModel.Downloads.IsLoading, Mode=OneWay}"
                    RetryCommand="{x:Bind ViewModel.Downloads.RefreshCommand}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.Downloads.ShowContent, Mode=OneWay}">
                    <ItemsRepeater MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" ItemsSource="{x:Bind ViewModel.Downloads.Items}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                <Border Style="{StaticResource RoGCardStyle}" AutomationProperties.Name="{x:Bind Title}">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                        <TextBlock
                                            MaxLines="4"
                                            Style="{StaticResource RoGBodyTextStyle}"
                                            Text="{x:Bind Changelog}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasChangelog}" />
                                        <ProgressBar Maximum="100" Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Uid="MediaPage_Download"
                                                Command="{x:Bind DownloadCommand}"
                                                IsEnabled="{x:Bind CanDownload, Mode=OneWay}"
                                                Style="{StaticResource RoGPrimaryButtonStyle}" />
                                            <Button
                                                x:Uid="MediaPage_ShowInFolder"
                                                Command="{x:Bind ShowInFolderCommand}"
                                                Style="{StaticResource RoGSecondaryButtonStyle}"
                                                Visibility="{x:Bind IsSaved, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Vollbild -->
        <Grid
            x:Name="Viewer"
            Background="{StaticResource RoGOverlayBrush}"
            Visibility="{x:Bind ViewModel.IsViewerOpen, Mode=OneWay}">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnViewerKey" />
                <KeyboardAccelerator Key="Left" Invoked="OnViewerKey" />
                <KeyboardAccelerator Key="Right" Invoked="OnViewerKey" />
            </Grid.KeyboardAccelerators>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                MaxZoomFactor="5"
                MinZoomFactor="1"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Enabled">
                <Image
                    Source="{x:Bind ViewModel.Viewed.Full, Mode=OneWay}"
                    Stretch="Uniform"
                    AutomationProperties.Name="{x:Bind ViewModel.Viewed.AutomationName, Mode=OneWay}" />
            </ScrollViewer>
            <Grid Grid.Row="1" Padding="16" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Uid="MediaPage_Previous" Click="OnPreviousClick"><FontIcon Glyph="&#xE76B;" /></Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Viewed.Caption, Mode=OneWay}" />
                    <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Viewed.Meta, Mode=OneWay}" />
                </StackPanel>
                <Button x:Uid="MediaPage_Next" Grid.Column="2" Click="OnNextClick"><FontIcon Glyph="&#xE76C;" /></Button>
                <Button x:Uid="Common_OpenInBrowser" Grid.Column="3" Command="{x:Bind ViewModel.Viewed.OpenInBrowserCommand, Mode=OneWay}" />
                <Button x:Uid="MediaPage_CloseViewer" Grid.Column="4" Command="{x:Bind ViewModel.CloseViewerCommand}"><FontIcon Glyph="&#xE711;" /></Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
