<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.MembersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
        <KeyboardAccelerator
            Key="F"
            Invoked="OnSearchInvoked"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <controls:ListDetailPanel DetailClosed="OnDetailClosed" IsDetailOpen="{x:Bind ViewModel.IsDetailOpen, Mode=OneWay}">
        <controls:ListDetailPanel.List>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="24,24,24,8" Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="MembersPage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="MITGLIEDER" />
                        <Button x:Uid="MembersPage_Map" Grid.Column="1" VerticalAlignment="Center" Click="OnMapClick" Style="{StaticResource RoGSecondaryButtonStyle}" Visibility="{x:Bind ViewModel.CanShowMap, Mode=OneWay}" />
                    </Grid>
                    <SelectorBar x:Name="ModeBar" SelectionChanged="OnModeChanged">
                        <SelectorBarItem x:Uid="MembersPage_ModeAll" IsSelected="True" />
                        <SelectorBarItem x:Uid="MembersPage_ModeTeam" />
                    </SelectorBar>
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Margin="24,0,24,8"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.ShowFilters, Mode=OneWay}">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        x:Uid="MembersPage_Search"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ToggleSwitch x:Uid="MembersPage_OnlineOnly" IsOn="{x:Bind ViewModel.OnlineOnly, Mode=TwoWay}" />
                </StackPanel>
                <controls:StateView
                    x:Uid="MembersPage_State"
                    Grid.Row="2"
                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
                <ListView
                    x:Uid="MembersPage_List"
                    Grid.Row="2"
                    Padding="12,0,12,12"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemberListItem">
                            <Grid Padding="0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <PersonPicture
                                        Width="40"
                                        Height="40"
                                        DisplayName="{x:Bind Name}"
                                        ProfilePicture="{x:Bind Avatar}"
                                        AutomationProperties.AccessibilityView="Raw" />
                                    <Ellipse
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Fill="{x:Bind PresenceBrush}"
                                        Style="{StaticResource RoGStatusDotStyle}"
                                        Visibility="{x:Bind HasPresence}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Name}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{x:Bind RankBrush}"
                                            Text="{x:Bind Rank}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        MaxLines="1"
                                        Style="{StaticResource RoGMutedTextStyle}"
                                        Text="{x:Bind Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Footer>
                        <Button
                            x:Uid="Common_LoadMore"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.LoadMoreCommand}"
                            Style="{StaticResource RoGSecondaryButtonStyle}"
                            Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
                    </ListView.Footer>
                </ListView>
            </Grid>
        </controls:ListDetailPanel.List>

        <!-- Profil -->
        <Grid>
            <TextBlock
                x:Uid="MembersPage_SelectHint"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource RoGMutedTextStyle}"
                Visibility="{x:Bind ViewModel.ShowSelectHint, Mode=OneWay}" />
            <controls:StateView
                ErrorMessage="{x:Bind ViewModel.Detail.ErrorMessage, Mode=OneWay}"
                IsLoading="{x:Bind ViewModel.Detail.IsLoading, Mode=OneWay}"
                RetryCommand="{x:Bind ViewModel.Detail.RefreshCommand}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.Detail.ShowContent, Mode=OneWay}">
                <StackPanel
                    MaxWidth="{StaticResource RoGReadingWidth}"
                    Padding="32,24,32,32"
                    HorizontalAlignment="Left"
                    Spacing="16">
                    <Grid MaxHeight="200" CornerRadius="{StaticResource RoGCardRadius}">
                        <Image Source="{x:Bind ViewModel.Detail.Banner, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <PersonPicture
                                Width="88"
                                Height="88"
                                DisplayName="{x:Bind ViewModel.Detail.Name, Mode=OneWay}"
                                ProfilePicture="{x:Bind ViewModel.Detail.Avatar, Mode=OneWay}"
                                AutomationProperties.AccessibilityView="Raw" />
                            <Ellipse
                                Width="16"
                                Height="16"
                                Margin="0,0,4,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Fill="{x:Bind ViewModel.Detail.PresenceBrushValue, Mode=OneWay}"
                                Stroke="{StaticResource RoGBgBrush}"
                                StrokeThickness="3" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource RoGTitleTextStyle}"
                                Text="{x:Bind ViewModel.Detail.Name, Mode=OneWay}"
                                AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock
                                FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                                FontSize="16"
                                CharacterSpacing="40"
                                Foreground="{x:Bind ViewModel.Detail.RankBrush, Mode=OneWay}"
                                Text="{x:Bind ViewModel.Detail.Rank, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Detail.PresenceText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        FontStyle="Italic"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource RoGBodyTextStyle}"
                        Text="{x:Bind ViewModel.Detail.Motto, Mode=OneWay}" />
                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Detail.Bio, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Detail.Facts, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Detail.Squads, Mode=OneWay}" />

                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Detail.HasBadges, Mode=OneWay}">
                        <TextBlock x:Uid="MembersPage_Badges" Style="{StaticResource RoGSectionTextStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Badges}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinColumnSpacing="8" MinItemWidth="140" MinRowSpacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:BadgeViewModel">
                                    <Border
                                        Padding="10,6"
                                        BorderBrush="{x:Bind ChipBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        ToolTipService.ToolTip="{x:Bind Description}">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{x:Bind ChipBrush}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Detail.HasPlatforms, Mode=OneWay}">
                        <TextBlock x:Uid="MembersPage_Platforms" Style="{StaticResource RoGSectionTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Detail.Platforms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="MembersPage_SendMessage"
                            Command="{x:Bind ViewModel.Detail.SendMessageCommand}"
                            Style="{StaticResource RoGPrimaryButtonStyle}"
                            Visibility="{x:Bind ViewModel.Detail.CanMessage, Mode=OneWay}" />
                        <Button
                            x:Uid="MembersPage_Befriend"
                            Command="{x:Bind ViewModel.Detail.BefriendCommand}"
                            Style="{StaticResource RoGSecondaryButtonStyle}"
                            Visibility="{x:Bind ViewModel.Detail.CanBefriend, Mode=OneWay}" />
                        <Button
                            x:Uid="AccountPage_OpenProfile"
                            Command="{x:Bind ViewModel.Detail.OpenProfileCommand}"
                            Style="{StaticResource RoGSecondaryButtonStyle}" />
                        <Button
                            x:Uid="Common_Report"
                            Command="{x:Bind ViewModel.Detail.ReportCommand}"
                            Visibility="{x:Bind ViewModel.Detail.CanReport, Mode=OneWay}" />
                    </StackPanel>
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.Detail.IsFriendFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.Detail.FriendFeedback, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.Detail.FriendFeedbackSeverity, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </controls:ListDetailPanel>
</Page>
