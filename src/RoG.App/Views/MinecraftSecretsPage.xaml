<?xml version="1.0" encoding="utf-8"?>
<!-- Minecraft-Secrets (Website v0.55.0): alle Lobby-Secrets mit Hinweis und Anzahl der Finder, eigene Funde mit Token. -->
<Page
    x:Class="RoG.App.Views.MinecraftSecretsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="{StaticResource RoGPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="8">
            <TextBlock x:Uid="SecretsPage_Title" Style="{StaticResource RoGDisplayTextStyle}" />
            <TextBlock x:Uid="SecretsPage_Intro" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
            <HyperlinkButton x:Uid="SecretsPage_Leaderboards" Padding="0" Click="OnLeaderboardsClick" />
        </StackPanel>

        <controls:StateView
            x:Uid="SecretsPage_State"
            Grid.Row="1"
            ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
            IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
        <ScrollViewer Grid.Row="1" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
            <ItemsControl MaxWidth="720" HorizontalAlignment="Left" ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SecretGroupViewModel">
                        <Border Margin="0,0,0,16" Style="{StaticResource RoGCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RoGSectionTextStyle}" Text="{x:Bind Title}" />
                                <TextBlock Grid.Column="1" Foreground="{StaticResource RoGGoldBrush}" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Progress}" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind Secrets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SecretEntryViewModel">
                                        <Grid Padding="0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Top"
                                                FontSize="16"
                                                Foreground="{StaticResource RoGGoldBrush}"
                                                Glyph="{x:Bind Glyph}"
                                                AutomationProperties.AccessibilityView="Raw" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Hint}" TextWrapping="Wrap" Visibility="{x:Bind HasHint}" />
                                                <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
