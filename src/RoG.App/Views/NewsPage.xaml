<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.NewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <controls:ListDetailPanel x:Name="Panel" DetailClosed="OnDetailClosed" IsDetailOpen="{x:Bind ViewModel.IsDetailOpen, Mode=OneWay}">
        <controls:ListDetailPanel.List>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Uid="NewsPage_Title"
                    Margin="24,24,24,12"
                    Style="{StaticResource RoGDisplayTextStyle}"
                    Text="NEWS" />
                <controls:StateView
                    Grid.Row="1"
                    x:Uid="NewsPage_State"
                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
                <ListView
                    x:Uid="NewsPage_List"
                    Grid.Row="1"
                    Padding="12,0,12,12"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    SelectionMode="Single"
                    Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NewsItemViewModel">
                            <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="96"
                                    Height="64"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource RoGBg3Brush}"
                                    CornerRadius="{StaticResource RoGControlRadius}">
                                    <Image Source="{x:Bind Cover}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                                        FontSize="12"
                                        CharacterSpacing="60"
                                        Foreground="{StaticResource RoGRedBrush}"
                                        Text="{x:Bind Category}"
                                        Visibility="{x:Bind HasCategory}" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        MaxLines="2"
                                        Style="{StaticResource RoGBodyTextStyle}"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        MaxLines="1"
                                        Style="{StaticResource RoGMutedTextStyle}"
                                        Text="{x:Bind Meta}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Footer>
                        <Button
                            x:Uid="Common_LoadMore"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.LoadMoreCommand}"
                            Style="{StaticResource RoGSecondaryButtonStyle}"
                            Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
                    </ListView.Footer>
                </ListView>
            </Grid>
        </controls:ListDetailPanel.List>

        <!-- Artikel -->
        <Grid>
            <TextBlock
                x:Uid="NewsPage_SelectHint"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource RoGMutedTextStyle}"
                Visibility="{x:Bind ViewModel.ShowSelectHint, Mode=OneWay}" />
            <controls:StateView
                ErrorMessage="{x:Bind ViewModel.Detail.ErrorMessage, Mode=OneWay}"
                IsLoading="{x:Bind ViewModel.Detail.IsLoading, Mode=OneWay}"
                RetryCommand="{x:Bind ViewModel.Detail.RefreshCommand}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.Detail.ShowContent, Mode=OneWay}">
                <StackPanel
                    MaxWidth="{StaticResource RoGReadingWidth}"
                    Padding="32,24,32,32"
                    HorizontalAlignment="Left"
                    Spacing="16">
                    <Image
                        MaxHeight="360"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{x:Bind ViewModel.Detail.CoverAlt, Mode=OneWay}"
                        Source="{x:Bind ViewModel.Detail.Cover, Mode=OneWay}"
                        Stretch="Uniform" />
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                            FontSize="14"
                            CharacterSpacing="60"
                            Foreground="{StaticResource RoGRedBrush}"
                            Text="{x:Bind ViewModel.Detail.Category, Mode=OneWay}" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource RoGTitleTextStyle}"
                            Text="{x:Bind ViewModel.Detail.Title, Mode=OneWay}"
                            AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Detail.Meta, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="Common_OpenInBrowser"
                            Command="{x:Bind ViewModel.Detail.OpenInBrowserCommand}"
                            Style="{StaticResource RoGSecondaryButtonStyle}" />
                        <Button
                            x:Uid="Common_CopyLink"
                            Command="{x:Bind ViewModel.Detail.CopyLinkCommand}"
                            Style="{StaticResource RoGSecondaryButtonStyle}" />
                    </StackPanel>
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.Detail.IsFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.Detail.Feedback, Mode=OneWay}"
                        Severity="Success" />
                    <controls:RichContentView Document="{x:Bind ViewModel.Detail.Body, Mode=OneWay}" />

                    <!-- Kommentare -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Detail.HasComments, Mode=OneWay}">
                        <TextBlock Style="{StaticResource RoGSectionTextStyle}" Text="{x:Bind ViewModel.Detail.CommentsHeader, Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Comments}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CommentViewModel">
                                    <Border Style="{StaticResource RoGCardStyle}" Padding="16,12">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Author}" />
                                                <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Time}" />
                                            </StackPanel>
                                            <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Body}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </controls:ListDetailPanel>
</Page>
