<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RoGBgBrush}">

    <!-- Gestalteter Leerzustand für Bereiche, die in späteren Stufen kommen. -->
    <Grid Padding="{StaticResource RoGPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource RoGDisplayTextStyle}" />
        <StackPanel
            Grid.Row="1"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <Image
                Width="96"
                Height="96"
                Opacity="0.35"
                Source="ms-appx:///Assets/rog-badge-512.png"
                AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                x:Name="ComingSoonText"
                HorizontalAlignment="Center"
                HorizontalTextAlignment="Center"
                Style="{StaticResource RoGMutedTextStyle}" />
        </StackPanel>
    </Grid>
</Page>
