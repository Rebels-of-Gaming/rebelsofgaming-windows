<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Grid Padding="{StaticResource RoGPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource RoGTitleTextStyle}" Text="{x:Bind ViewModel.Header, Mode=OneWay}" />
        <controls:StateView
            x:Uid="SearchPage_State"
            Grid.Row="1"
            ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
            IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
            <ItemsRepeater MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" ItemsSource="{x:Bind ViewModel.Rows}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchRowViewModel">
                        <Grid>
                            <TextBlock
                                Margin="0,16,0,4"
                                Style="{StaticResource RoGSectionTextStyle}"
                                Text="{x:Bind Title}"
                                Visibility="{x:Bind IsGroup}"
                                AutomationProperties.HeadingLevel="Level2" />
                            <Button
                                Padding="12,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind OpenCommand}"
                                Visibility="{x:Bind IsHit}"
                                AutomationProperties.Name="{x:Bind Title}">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" />
                                    <TextBlock
                                        MaxLines="2"
                                        Style="{StaticResource RoGMutedTextStyle}"
                                        Text="{x:Bind Excerpt}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind HasExcerpt}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource RoGRedBrush}"
                                        Text="{x:Bind Meta}"
                                        Visibility="{x:Bind HasMeta}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
