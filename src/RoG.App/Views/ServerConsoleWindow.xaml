<?xml version="1.0" encoding="utf-8"?>
<!-- Server-Steuerung als eigenes Fenster (Pflichtenheft Stufe 7: Konsole im eigenen Fenster). -->
<Window
    x:Class="RoG.App.Views.ServerConsoleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RoG.App.ViewModels">

    <Grid Background="{StaticResource RoGBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Padding="16,0,140,0" Background="{StaticResource RoGBg2Brush}">
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                FontSize="14"
                CharacterSpacing="60"
                Foreground="{StaticResource RoGMutedBrush}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" Padding="16,12" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
                <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.ResourcesText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.CanPower}">
                <Button x:Uid="Console_Start" Command="{x:Bind ViewModel.StartServerCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" Visibility="{x:Bind ViewModel.IsStopped, Mode=OneWay}" />
                <Button x:Uid="Console_StartSecondary" Command="{x:Bind ViewModel.StartServerCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                <Button x:Uid="Console_Restart" Command="{x:Bind ViewModel.RestartServerCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                <Button x:Uid="Console_Stop" Command="{x:Bind ViewModel.StopServerCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                <Button x:Uid="Console_Kill" Click="OnKillClick" Style="{StaticResource RoGSecondaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="2"
            Margin="16,0"
            IsOpen="{x:Bind ViewModel.IsFeedbackOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.FeedbackSeverity, Mode=OneWay}" />

        <!-- Reiter waagrecht scrollbar: im schmalen Fenster sonst abgeschnitten -->
        <ScrollViewer
            Grid.Row="3"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
        <SelectorBar x:Name="Tabs" Margin="12,0" SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Name="ConsoleTab" x:Uid="Console_TabConsole" />
            <SelectorBarItem x:Name="ConfigsTab" x:Uid="Console_TabConfigs" />
            <SelectorBarItem x:Name="FilesTab" x:Uid="Console_TabFiles" />
            <SelectorBarItem x:Name="BackupsTab" x:Uid="Console_TabBackups" />
            <SelectorBarItem x:Name="RconTab" x:Uid="Console_TabRcon" />
            <SelectorBarItem x:Name="BansTab" x:Uid="Console_TabBans" />
            <SelectorBarItem x:Name="WhitelistTab" x:Uid="Console_TabWhitelist" />
            <SelectorBarItem x:Name="GameBansTab" x:Uid="Console_TabGameBans" />
            <SelectorBarItem x:Name="ApprovalsTab" x:Uid="Console_TabApprovals" />
        </SelectorBar>
        </ScrollViewer>

        <Grid x:Name="ConsolePanel" Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="16,8,16,0"
                AutomationProperties.LiveSetting="Polite"
                FontSize="12"
                Style="{StaticResource RoGMutedTextStyle}"
                Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}"
                TextWrapping="Wrap" />
            <ListView
                x:Name="Output"
                x:Uid="Console_Output"
                Grid.Row="1"
                Margin="16,8"
                Padding="8"
                Background="{StaticResource RoGBg2Brush}"
                CornerRadius="{StaticResource RoGControlRadius}"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.Lines}"
                SelectionMode="Extended">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="4,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{StaticResource RoGInkBrush}" Text="{x:Bind}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="2" Padding="16,0,16,16" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Uid="Console_Command"
                    FontFamily="Consolas"
                    IsEnabled="{x:Bind ViewModel.CanCommand, Mode=OneWay}"
                    KeyDown="OnCommandKeyDown"
                    MaxLength="500"
                    Text="{x:Bind ViewModel.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button x:Uid="Console_Send" Grid.Column="1" Command="{x:Bind ViewModel.SendCommand}" IsEnabled="{x:Bind ViewModel.CanCommand, Mode=OneWay}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                <Button x:Uid="Console_Reconnect" Grid.Column="2" Command="{x:Bind ViewModel.ConnectCommand}" />
                <Button x:Uid="Console_Clear" Grid.Column="3" Command="{x:Bind ViewModel.ClearLinesCommand}" />
            </Grid>
        </Grid>

        <!-- Configs -->
        <Grid x:Name="ConfigsPanel" Grid.Row="4" Padding="16,8,16,16" ColumnSpacing="16" RowSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Uid="Config_File"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{x:Bind Configs.Files}"
                    SelectedItem="{x:Bind Configs.SelectedFile, Mode=TwoWay}" />
                <Button
                    x:Uid="Config_Template"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="OnTemplateClick"
                    Style="{StaticResource RoGSecondaryButtonStyle}"
                    Visibility="{x:Bind Configs.HasTemplate, Mode=OneWay}" />
            </Grid>
            <TextBlock
                x:Uid="Config_Empty"
                Grid.Row="1"
                Style="{StaticResource RoGMutedTextStyle}"
                Visibility="{x:Bind Configs.IsEmpty, Mode=OneWay}" />
            <TextBox
                x:Uid="Config_Editor"
                Grid.Row="1"
                AcceptsReturn="True"
                FontFamily="Consolas"
                IsReadOnly="{x:Bind Configs.IsReadOnly}"
                IsSpellCheckEnabled="False"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind Configs.Content, Mode=TwoWay}"
                TextWrapping="NoWrap" />
            <Grid Grid.Row="2" ColumnSpacing="8" Visibility="{x:Bind Configs.CanWrite}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Uid="Config_Note" Text="{x:Bind Configs.Note, Mode=TwoWay}" />
                <ComboBox x:Uid="Config_After" Grid.Column="1" ItemsSource="{x:Bind Configs.AfterOptions}" SelectedItem="{x:Bind Configs.SelectedAfter, Mode=TwoWay}" />
                <Button x:Uid="Config_Preview" Grid.Column="2" Command="{x:Bind Configs.PreviewCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                <Button x:Uid="Config_Save" Grid.Column="3" Command="{x:Bind Configs.SaveCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
            </Grid>
            <ScrollViewer Grid.RowSpan="3" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <InfoBar IsClosable="False" IsOpen="{x:Bind Configs.HasErrors, Mode=OneWay}" Message="{x:Bind Configs.ErrorsText, Mode=OneWay}" Severity="Error" />
                    <TextBlock x:Uid="Config_DiffTitle" Style="{StaticResource RoGSectionTextStyle}" Visibility="{x:Bind Configs.HasDiff, Mode=OneWay}" />
                    <TextBlock FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Configs.DiffText, Mode=OneWay}" />
                    <TextBlock x:Uid="Config_VersionsTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Configs.Versions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConfigVersionItemViewModel">
                                <StackPanel Padding="0,4" Spacing="4">
                                    <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Text}" TextWrapping="Wrap" />
                                    <HyperlinkButton x:Uid="Config_Rollback" Padding="0" Command="{x:Bind RollbackCommand}" Visibility="{x:Bind CanWrite}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Backups -->
        <Grid x:Name="BackupsPanel" Grid.Row="4" Padding="16,8,16,16" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Uid="Backup_Name" Width="260" Text="{x:Bind Backups.NewName, Mode=TwoWay}" />
                <Button x:Uid="Backup_Create" Command="{x:Bind Backups.CreateCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                <Button x:Uid="Backup_Reload" Command="{x:Bind Backups.ReloadCommand}" />
            </StackPanel>
            <TextBlock x:Uid="Backup_Empty" Grid.Row="1" Style="{StaticResource RoGMutedTextStyle}" Visibility="{x:Bind Backups.IsEmpty, Mode=OneWay}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind Backups.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BackupItemViewModel">
                            <Grid Padding="0,8" ColumnSpacing="8" AutomationProperties.Name="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Name}" />
                                    <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Uid="Backup_Download" Command="{x:Bind DownloadCommand}" IsEnabled="{x:Bind IsReady}" />
                                    <Button Command="{x:Bind ToggleLockCommand}" Content="{x:Bind LockLabel}" />
                                    <Button x:Uid="Backup_Restore" Command="{x:Bind RestoreCommand}" IsEnabled="{x:Bind IsReady}" />
                                    <Button x:Uid="Backup_Delete" Command="{x:Bind DeleteCommand}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <!-- RCON -->
        <Grid x:Name="RconPanel" Grid.Row="4" Padding="16,8,16,16" RowSpacing="8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Padding="8" Background="{StaticResource RoGBg2Brush}" CornerRadius="{StaticResource RoGControlRadius}" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Uid="Rcon_Output" FontFamily="Consolas" FontSize="13" IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Rcon.Output, Mode=OneWay}" />
            </ScrollViewer>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Uid="Rcon_Command" FontFamily="Consolas" KeyDown="OnRconKeyDown" MaxLength="500" Text="{x:Bind Rcon.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button x:Uid="Console_Send" Grid.Column="1" Command="{x:Bind Rcon.SendCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
            </Grid>
        </Grid>

        <!-- Sperren -->
        <Grid x:Name="BansPanel" Grid.Row="4" Padding="16,8,16,16" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="Ban_NewTitle" Style="{StaticResource RoGSectionTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Uid="Ban_PlayerId" Width="220" Text="{x:Bind Bans.PlayerId, Mode=TwoWay}" />
                    <TextBox x:Uid="Ban_PlayerName" Width="180" Text="{x:Bind Bans.PlayerName, Mode=TwoWay}" />
                    <NumberBox x:Uid="Ban_Minutes" Width="140" Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind Bans.Minutes, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Uid="Ban_Reason" Width="420" Text="{x:Bind Bans.Reason, Mode=TwoWay}" />
                    <Button x:Uid="Ban_Submit" VerticalAlignment="Bottom" Command="{x:Bind Bans.BanCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                    <Button x:Uid="Backup_Reload" VerticalAlignment="Bottom" Command="{x:Bind Bans.ReloadCommand}" />
                </StackPanel>
                <TextBlock x:Uid="Ban_Hint" FontSize="12" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Uid="Ban_Empty" Grid.Row="1" Style="{StaticResource RoGMutedTextStyle}" Visibility="{x:Bind Bans.IsEmpty, Mode=OneWay}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind Bans.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BanItemViewModel">
                            <Grid Padding="0,8" ColumnSpacing="8" AutomationProperties.Name="{x:Bind Player}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Player}" />
                                    <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                </StackPanel>
                                <Button x:Uid="Ban_Lift" Grid.Column="1" Command="{x:Bind LiftCommand}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Bans & Plugin (zentrale Gameserver-Bans, Plugin-Schlüssel) -->
        <ScrollViewer x:Name="GameBansPanel" Grid.Row="4" Padding="16,8,16,16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="16">
                <!-- Plugin-Schlüssel -->
                <Border Padding="12" Background="{StaticResource RoGBg2Brush}" CornerRadius="{StaticResource RoGControlRadius}" Visibility="{x:Bind GameBans.HasKeySection, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="GameBans_KeyTitle" Style="{StaticResource RoGSectionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse VerticalAlignment="Center" Fill="{x:Bind GameBans.KeyBrush, Mode=OneWay}" Style="{StaticResource RoGStatusDotStyle}" />
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind GameBans.KeyStatus, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock FontSize="12" IsTextSelectionEnabled="True" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind GameBans.KeyDetails, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock x:Uid="GameBans_KeyHint" FontSize="12" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Uid="GameBans_RightsTitle" Margin="0,4,0,0" FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" />
                        <CheckBox x:Uid="GameBans_MayIssue" IsChecked="{x:Bind GameBans.MayIssue, Mode=TwoWay}" />
                        <StackPanel Spacing="4" Visibility="{x:Bind GameBans.IsManager}">
                            <CheckBox x:Uid="GameBans_MayLift" IsChecked="{x:Bind GameBans.MayLift, Mode=TwoWay}" />
                            <CheckBox x:Uid="GameBans_MayLiftAny" IsChecked="{x:Bind GameBans.MayLiftAny, Mode=TwoWay}" />
                            <CheckBox x:Uid="GameBans_MayIp" IsChecked="{x:Bind GameBans.MayIp, Mode=TwoWay}" />
                            <CheckBox x:Uid="GameBans_MayBanMembers" IsChecked="{x:Bind GameBans.MayBanMembers, Mode=TwoWay}" />
                            <ComboBox x:Uid="GameBans_MaxScope" MinWidth="200" ItemsSource="{x:Bind GameBans.MaxScopeOptions}" SelectedItem="{x:Bind GameBans.SelectedMaxScope, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind GameBans.CreateKeyCommand}" Content="{x:Bind GameBans.KeyActionText, Mode=OneWay}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                            <Button x:Uid="GameBans_SaveRights" Command="{x:Bind GameBans.SaveRightsCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" Visibility="{x:Bind GameBans.KeyExists, Mode=OneWay}" />
                            <Button x:Uid="GameBans_Revoke" Command="{x:Bind GameBans.RevokeKeyCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" Visibility="{x:Bind GameBans.KeyExists, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" Spacing="6" Visibility="{x:Bind GameBans.IsManager}">
                            <TextBlock x:Uid="GameBans_IncidentHeading" FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" />
                            <TextBlock x:Uid="GameBans_IncidentHint" FontSize="12" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Uid="GameBans_IncidentReason" Width="360" MaxLength="200" Text="{x:Bind GameBans.IncidentReason, Mode=TwoWay}" />
                                <Button x:Uid="GameBans_IncidentLift" VerticalAlignment="Bottom" Command="{x:Bind GameBans.LiftPluginBansCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Neuer Ban -->
                <StackPanel Spacing="8" Visibility="{x:Bind GameBans.CanBans}">
                    <TextBlock x:Uid="GameBans_NewTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Uid="GameBans_Identifier" Width="300" IsSpellCheckEnabled="False" MaxLength="64" Text="{x:Bind GameBans.Identifier, Mode=TwoWay}" />
                        <TextBox x:Uid="GameBans_IdentifierType" Width="160" IsSpellCheckEnabled="False" MaxLength="16" Text="{x:Bind GameBans.IdentifierType, Mode=TwoWay}" />
                        <TextBox x:Uid="GameBans_Name" Width="200" Text="{x:Bind GameBans.PlayerName, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Uid="GameBans_ScopeBox" MinWidth="180" ItemsSource="{x:Bind GameBans.ScopeOptions}" SelectedItem="{x:Bind GameBans.SelectedScope, Mode=TwoWay}" />
                        <NumberBox x:Uid="GameBans_Minutes" Width="160" Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind GameBans.Minutes, Mode=TwoWay}" />
                        <TextBox x:Uid="GameBans_Ip" Width="200" IsSpellCheckEnabled="False" Text="{x:Bind GameBans.Ip, Mode=TwoWay}" Visibility="{x:Bind GameBans.IsManager}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Uid="GameBans_Reason" Width="480" MaxLength="200" Text="{x:Bind GameBans.Reason, Mode=TwoWay}" />
                        <Button x:Uid="GameBans_Create" VerticalAlignment="Bottom" Command="{x:Bind GameBans.CreateCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Uid="GameBans_NewHint" FontSize="12" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Liste -->
                <StackPanel Spacing="8" Visibility="{x:Bind GameBans.CanBans}">
                    <TextBlock x:Uid="GameBans_ListTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Uid="GameBans_StatusBox" MinWidth="160" ItemsSource="{x:Bind GameBans.StatusOptions}" SelectedItem="{x:Bind GameBans.SelectedStatus, Mode=TwoWay}" />
                        <TextBox x:Uid="GameBans_Search" Width="240" KeyDown="OnGameBanSearchKeyDown" Text="{x:Bind GameBans.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Uid="GameBans_SearchButton" VerticalAlignment="Bottom" Command="{x:Bind GameBans.SearchCommand}" />
                        <Button x:Uid="Backup_Reload" VerticalAlignment="Bottom" Command="{x:Bind GameBans.ReloadCommand}" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind GameBans.IsBusy, Mode=OneWay}" />
                    <TextBlock x:Uid="GameBans_Empty" Style="{StaticResource RoGMutedTextStyle}" Visibility="{x:Bind GameBans.IsEmpty, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind GameBans.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameBanItemViewModel">
                                <Border Margin="0,0,0,8" Padding="12" AutomationProperties.Name="{x:Bind Title}" Background="{StaticResource RoGBg2Brush}" CornerRadius="{StaticResource RoGControlRadius}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse VerticalAlignment="Center" Fill="{x:Bind StatusBrush}" Style="{StaticResource RoGStatusDotStyle}" />
                                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" />
                                            <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind StatusText}" />
                                        </StackPanel>
                                        <TextBlock FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Identity}" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" IsTextSelectionEnabled="True" Foreground="{StaticResource RoGGoldBrush}" Text="{x:Bind PublicInfo}" TextWrapping="Wrap" Visibility="{x:Bind HasPublicInfo}" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Deliveries, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind HasDeliveries, Mode=OneWay}" />
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                                            <Button x:Uid="GameBans_Edit" Command="{x:Bind EditCommand}" Visibility="{x:Bind IsActive}" />
                                            <Button x:Uid="GameBans_Lift" Command="{x:Bind LiftCommand}" Visibility="{x:Bind IsActive}" />
                                            <Button x:Uid="GameBans_Details" Command="{x:Bind DetailsCommand}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Command="{x:Bind TogglePublicCommand}" Content="{x:Bind ToggleText}" AutomationProperties.Name="{x:Bind ToggleText}" />
                                            <Button x:Uid="GameBans_OpenPublic" Command="{x:Bind OpenPublicCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" Visibility="{x:Bind HasPublicUrl}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Uid="GameBans_More" HorizontalAlignment="Center" Command="{x:Bind GameBans.LoadMoreCommand}" Visibility="{x:Bind GameBans.HasMore, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Freigaben -->
        <Grid x:Name="ApprovalsPanel" Grid.Row="4" Padding="16,8,16,16" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button x:Uid="Backup_Reload" Command="{x:Bind Approvals.ReloadCommand}" />
            <TextBlock x:Uid="Approval_Empty" Grid.Row="1" Style="{StaticResource RoGMutedTextStyle}" Visibility="{x:Bind Approvals.IsEmpty, Mode=OneWay}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind Approvals.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChangeItemViewModel">
                            <Border Margin="0,0,0,12" Padding="12" Background="{StaticResource RoGBg2Brush}" CornerRadius="{StaticResource RoGControlRadius}">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" />
                                    <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" TextWrapping="Wrap" />
                                    <TextBlock FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Diff}" />
                                    <TextBox x:Uid="Approval_Note" Text="{x:Bind Note, Mode=TwoWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="Approval_Approve" Command="{x:Bind ApproveCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                                        <Button x:Uid="Approval_Reject" Command="{x:Bind RejectCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Dateien -->
        <Grid x:Name="FilesPanel" Grid.Row="4" Padding="16,8,16,16" ColumnSpacing="16" RowSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="Files_Up" Command="{x:Bind Files.UpCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE74A;" />
                </Button>
                <Button x:Uid="Backup_Reload" Command="{x:Bind Files.ReloadCommand}" />
                <ItemsControl VerticalAlignment="Center" ItemsSource="{x:Bind Files.Crumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileCrumb">
                            <HyperlinkButton Padding="4,0" Click="OnCrumbClick" Content="{x:Bind Name}" Tag="{x:Bind Target}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <TextBlock x:Uid="Files_Empty" Grid.Row="1" Style="{StaticResource RoGMutedTextStyle}" Visibility="{x:Bind Files.IsEmpty, Mode=OneWay}" />
            <ListView
                x:Uid="Files_List"
                Grid.Row="1"
                IsItemClickEnabled="True"
                ItemClick="OnFileClick"
                ItemsSource="{x:Bind Files.Items}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileItemViewModel">
                        <Grid Padding="0,6" ColumnSpacing="8" AutomationProperties.Name="{x:Bind Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="16" Foreground="{StaticResource RoGMutedBrush}" Glyph="{x:Bind Glyph}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <Button x:Uid="Files_Copy" Command="{x:Bind CopyCommand}" Visibility="{x:Bind CanCopy}">
                                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                </Button>
                                <Button x:Uid="Files_Rename" Command="{x:Bind RenameCommand}" Visibility="{x:Bind CanChange}">
                                    <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                                </Button>
                                <Button x:Uid="Files_Delete" Command="{x:Bind DeleteCommand}" Visibility="{x:Bind CanChange}">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Style="{StaticResource RoGBodyTextStyle}"
                Text="{x:Bind Files.PreviewTitle, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBox
                x:Uid="Files_Preview"
                Grid.Row="1"
                Grid.Column="1"
                AcceptsReturn="True"
                FontFamily="Consolas"
                IsReadOnly="True"
                IsSpellCheckEnabled="False"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind Files.Preview, Mode=OneWay}"
                TextWrapping="NoWrap" />
        </Grid>

        <!-- Whitelist -->
        <Grid x:Name="WhitelistPanel" Grid.Row="4" Padding="16,8,16,16" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Uid="Whitelist_Player" Width="260" Text="{x:Bind Whitelist.PlayerName, Mode=TwoWay}" />
                    <Button x:Uid="Whitelist_Add" VerticalAlignment="Bottom" Command="{x:Bind Whitelist.AddCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                    <Button x:Uid="Backup_Reload" VerticalAlignment="Bottom" Command="{x:Bind Whitelist.ReloadCommand}" />
                </StackPanel>
                <TextBlock x:Uid="Whitelist_Hint" FontSize="12" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Uid="Whitelist_Empty" Grid.Row="1" Style="{StaticResource RoGMutedTextStyle}" Visibility="{x:Bind Whitelist.IsEmpty, Mode=OneWay}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind Whitelist.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WhitelistItemViewModel">
                            <Grid Padding="0,6" ColumnSpacing="8" AutomationProperties.Name="{x:Bind Display}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Display}" />
                                <Button x:Uid="Whitelist_Remove" Grid.Column="1" Command="{x:Bind RemoveCommand}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
