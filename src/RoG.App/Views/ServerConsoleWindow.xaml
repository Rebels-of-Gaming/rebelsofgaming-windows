<?xml version="1.0" encoding="utf-8"?>
<!-- Server-Steuerung als eigenes Fenster (Pflichtenheft Stufe 7: Konsole im eigenen Fenster). -->
<Window
    x:Class="RoG.App.Views.ServerConsoleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource RoGBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Padding="16,0,140,0" Background="{StaticResource RoGBg2Brush}">
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                FontSize="14"
                CharacterSpacing="60"
                Foreground="{StaticResource RoGMutedBrush}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" Padding="16,12" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
                <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.ResourcesText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.CanPower}">
                <Button x:Uid="Console_Start" Command="{x:Bind ViewModel.StartServerCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                <Button x:Uid="Console_Restart" Command="{x:Bind ViewModel.RestartServerCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                <Button x:Uid="Console_Stop" Command="{x:Bind ViewModel.StopServerCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                <Button x:Uid="Console_Kill" Click="OnKillClick" Style="{StaticResource RoGSecondaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="2"
            Margin="16,0"
            IsOpen="{x:Bind ViewModel.IsFeedbackOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.FeedbackSeverity, Mode=OneWay}" />

        <ListView
            x:Name="Output"
            x:Uid="Console_Output"
            Grid.Row="3"
            Margin="16,8"
            Padding="8"
            Background="{StaticResource RoGBg2Brush}"
            CornerRadius="{StaticResource RoGControlRadius}"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Lines}"
            SelectionMode="Extended">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="4,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{StaticResource RoGInkBrush}" Text="{x:Bind}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="4" Padding="16,0,16,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Uid="Console_Command"
                FontFamily="Consolas"
                IsEnabled="{x:Bind ViewModel.CanCommand, Mode=OneWay}"
                KeyDown="OnCommandKeyDown"
                MaxLength="500"
                Text="{x:Bind ViewModel.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Uid="Console_Send" Grid.Column="1" Command="{x:Bind ViewModel.SendCommand}" IsEnabled="{x:Bind ViewModel.CanCommand, Mode=OneWay}" Style="{StaticResource RoGPrimaryButtonStyle}" />
            <Button x:Uid="Console_Reconnect" Grid.Column="2" Command="{x:Bind ViewModel.ConnectCommand}" />
            <Button x:Uid="Console_Clear" Grid.Column="3" Command="{x:Bind ViewModel.ClearLinesCommand}" />
        </Grid>
    </Grid>
</Window>
