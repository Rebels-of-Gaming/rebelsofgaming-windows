<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Grid Padding="{StaticResource RoGPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf: Titel + Aktualisieren -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="ServersPage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="SERVER" />
            <Button
                x:Uid="ServersPage_Refresh"
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Style="{StaticResource RoGSecondaryButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                    <KeyboardAccelerator Key="R" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <TextBlock
            x:Uid="ServersPage_Intro"
            Grid.Row="1"
            MaxWidth="{StaticResource RoGReadingWidth}"
            HorizontalAlignment="Left"
            Style="{StaticResource RoGMutedTextStyle}" />

        <!-- Rückmeldung zu Verbinden/Kopieren -->
        <InfoBar
            Grid.Row="2"
            IsOpen="{x:Bind ViewModel.IsFeedbackOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.FeedbackSeverity, Mode=OneWay}" />

        <Grid Grid.Row="3">
            <!-- Laden -->
            <ProgressRing
                x:Uid="ServersPage_Loading"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- Fehler -->
            <StackPanel
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <TextBlock
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource RoGBodyTextStyle}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                <Button
                    x:Uid="ServersPage_Retry"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource RoGPrimaryButtonStyle}" />
            </StackPanel>

            <!-- Leer -->
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <Image
                    Width="96"
                    Height="96"
                    Opacity="0.35"
                    Source="ms-appx:///Assets/rog-badge-512.png"
                    AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    x:Uid="ServersPage_Empty"
                    HorizontalAlignment="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource RoGMutedTextStyle}" />
            </StackPanel>

            <!-- Liste: Karten, die sich auf die Fensterbreite verteilen -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Servers}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="16"
                            MinItemWidth="320"
                            MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerItemViewModel">
                            <Border AutomationProperties.Name="{x:Bind Name}" Style="{StaticResource RoGCardStyle}">
                                <StackPanel Spacing="10">
                                    <!-- Status + Spiel -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Fill="{x:Bind StatusBrush}" Style="{StaticResource RoGStatusDotStyle}" />
                                        <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind StatusText}" />
                                        <TextBlock
                                            Style="{StaticResource RoGMutedTextStyle}"
                                            Text="·"
                                            Visibility="{x:Bind HasGame}" />
                                        <TextBlock
                                            Style="{StaticResource RoGMutedTextStyle}"
                                            Text="{x:Bind Game}"
                                            Visibility="{x:Bind HasGame}" />
                                    </StackPanel>

                                    <TextBlock
                                        MaxLines="2"
                                        Style="{StaticResource RoGTitleTextStyle}"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!-- Map, Spieler, Adresse -->
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Style="{StaticResource RoGBodyTextStyle}"
                                            Text="{x:Bind Map}"
                                            Visibility="{x:Bind HasMap}" />
                                        <TextBlock
                                            Style="{StaticResource RoGBodyTextStyle}"
                                            Text="{x:Bind PlayersText}"
                                            Visibility="{x:Bind ShowPlayers}" />
                                        <TextBlock
                                            FontFamily="Consolas"
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource RoGMutedTextStyle}"
                                            Text="{x:Bind Address}" />
                                    </StackPanel>

                                    <!-- Spielerliste (nur für Mitglieder von der API geliefert) -->
                                    <Expander
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Header="{x:Bind PlayersHeader}"
                                        Visibility="{x:Bind HasPlayerList}">
                                        <ItemsControl ItemsSource="{x:Bind Players}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- Aktionen -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Uid="ServerCard_Connect"
                                            AutomationProperties.Name="{x:Bind ConnectAutomationName}"
                                            Command="{x:Bind ConnectCommand}"
                                            Style="{StaticResource RoGPrimaryButtonStyle}"
                                            Visibility="{x:Bind CanConnect}" />
                                        <Button
                                            x:Uid="ServerCard_Copy"
                                            AutomationProperties.Name="{x:Bind CopyAutomationName}"
                                            Command="{x:Bind CopyCommand}"
                                            Style="{StaticResource RoGSecondaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
