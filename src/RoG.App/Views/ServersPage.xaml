<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Grid Padding="{StaticResource RoGPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf: Titel + Aktualisieren -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="ServersPage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="SERVER" />
            <Button
                x:Uid="ServersPage_Provision"
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ProvisionCommand}"
                Style="{StaticResource RoGPrimaryButtonStyle}"
                Visibility="{x:Bind ViewModel.CanProvision}" />
            <Button
                x:Uid="ServersPage_BanList"
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="OnBanListClick"
                Style="{StaticResource RoGSecondaryButtonStyle}" />
            <Button
                x:Uid="ServersPage_Leaderboards"
                Grid.Column="3"
                VerticalAlignment="Center"
                Click="OnLeaderboardsClick"
                Style="{StaticResource RoGSecondaryButtonStyle}" />
            <Button
                x:Uid="ServersPage_Refresh"
                Grid.Column="4"
                VerticalAlignment="Center"
                Click="OnRefreshClick"
                Style="{StaticResource RoGSecondaryButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                    <KeyboardAccelerator Key="R" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <SelectorBar
            x:Name="TabBar"
            Grid.Row="1"
            SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Uid="ServersPage_TabGame" IsSelected="True" />
            <SelectorBarItem x:Uid="ServersPage_TabMinecraft" />
            <SelectorBarItem x:Uid="ServersPage_TabTeamSpeak" />
            <SelectorBarItem x:Uid="ServersPage_TabDiscord" />
        </SelectorBar>

        <TextBlock
            x:Name="GameIntro"
            x:Uid="ServersPage_Intro"
            Grid.Row="2"
            MaxWidth="{StaticResource RoGReadingWidth}"
            HorizontalAlignment="Left"
            Style="{StaticResource RoGMutedTextStyle}" />

        <!-- Rückmeldung zu Verbinden/Kopieren -->
        <InfoBar
            Grid.Row="3"
            IsOpen="{x:Bind ViewModel.IsFeedbackOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.FeedbackSeverity, Mode=OneWay}" />

        <InfoBar
            Grid.Row="3"
            IsOpen="{x:Bind Voice.IsFeedbackOpen, Mode=TwoWay}"
            Message="{x:Bind Voice.FeedbackMessage, Mode=OneWay}"
            Severity="{x:Bind Voice.FeedbackSeverity, Mode=OneWay}" />

        <InfoBar
            Grid.Row="3"
            IsOpen="{x:Bind Join.IsFeedbackOpen, Mode=TwoWay}"
            Message="{x:Bind Join.FeedbackMessage, Mode=OneWay}"
            Severity="{x:Bind Join.FeedbackSeverity, Mode=OneWay}" />

        <Grid x:Name="GamePanel" Grid.Row="4">
            <!-- Laden -->
            <ProgressRing
                x:Uid="ServersPage_Loading"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- Fehler -->
            <StackPanel
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <TextBlock
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource RoGBodyTextStyle}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                <Button
                    x:Uid="ServersPage_Retry"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource RoGPrimaryButtonStyle}" />
            </StackPanel>

            <!-- Leer -->
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <Image
                    Width="96"
                    Height="96"
                    Opacity="0.35"
                    Source="ms-appx:///Assets/rog-badge-512.png"
                    AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    x:Uid="ServersPage_Empty"
                    HorizontalAlignment="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource RoGMutedTextStyle}" />
            </StackPanel>

            <!-- Liste: Karten, die sich auf die Fensterbreite verteilen -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Servers}">
                    <ItemsRepeater.Layout>
                        <!-- Zeilenhöhe je höchster Karte: aufgeklappte Ports/Auslastung werden nicht abgeschnitten -->
<controls:CardGridLayout ColumnSpacing="16" MinItemWidth="320" RowSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerItemViewModel">
                            <controls:ServerCard Item="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- Minecraft: So kommst du auf den Server -->
        <Grid
            x:Name="MinecraftPanel"
            Grid.Row="4"
            Visibility="Collapsed">
            <controls:StateView
                x:Uid="ServersPage_McState"
                ErrorMessage="{x:Bind Join.ErrorMessage, Mode=OneWay}"
                IsLoading="{x:Bind Join.IsLoading, Mode=OneWay}"
                RetryCommand="{x:Bind Join.RefreshCommand}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind Join.HasJoin, Mode=OneWay}">
                <StackPanel
                    MaxWidth="{StaticResource RoGReadingWidth}"
                    HorizontalAlignment="Left"
                    Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="McJoin_Title" Style="{StaticResource RoGTitleTextStyle}" />
                        <TextBlock x:Uid="McJoin_Lead" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Java -->
                    <Border Style="{StaticResource RoGCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="McJoin_JavaTitle" Style="{StaticResource RoGSectionTextStyle}" />
                            <TextBlock x:Uid="McJoin_JavaPlatforms" Style="{StaticResource RoGMutedTextStyle}" />
                            <TextBlock x:Uid="McJoin_JavaStep1" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="McJoin_JavaStep2" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="McJoin_JavaStep3" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Uid="McJoin_Address" VerticalAlignment="Center" Style="{StaticResource RoGMutedTextStyle}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    IsTextSelectionEnabled="True"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource RoGBodyTextStyle}"
                                    Text="{x:Bind Join.JavaAddress, Mode=OneWay}" />
                                <Button x:Uid="McJoin_CopyJava" Command="{x:Bind Join.CopyJavaCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock
                                x:Uid="McJoin_DefaultPort"
                                Style="{StaticResource RoGMutedTextStyle}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind Join.ShowDefaultPortNote, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Bedrock -->
                    <Border Style="{StaticResource RoGCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="McJoin_BedrockTitle" Style="{StaticResource RoGSectionTextStyle}" />
                            <TextBlock x:Uid="McJoin_BedrockPlatforms" Style="{StaticResource RoGMutedTextStyle}" />
                            <TextBlock x:Uid="McJoin_BedrockStep1" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="McJoin_BedrockStep2" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="McJoin_BedrockStep3" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Uid="McJoin_Address" VerticalAlignment="Center" Style="{StaticResource RoGMutedTextStyle}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    IsTextSelectionEnabled="True"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource RoGBodyTextStyle}"
                                    Text="{x:Bind Join.BedrockAddress, Mode=OneWay}" />
                                <Button x:Uid="McJoin_CopyBedrockAddress" Command="{x:Bind Join.CopyBedrockAddressCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Uid="McJoin_Port" VerticalAlignment="Center" Style="{StaticResource RoGMutedTextStyle}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    IsTextSelectionEnabled="True"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource RoGBodyTextStyle}"
                                    Text="{x:Bind Join.BedrockPort, Mode=OneWay}" />
                                <Button x:Uid="McJoin_CopyBedrockPort" Command="{x:Bind Join.CopyBedrockPortCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Konsole -->
                    <Border Style="{StaticResource RoGCardStyle}" Visibility="{x:Bind Join.ShowConsole, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="McJoin_ConsoleTitle" Style="{StaticResource RoGSectionTextStyle}" />
                            <TextBlock x:Uid="McJoin_ConsolePlatforms" Style="{StaticResource RoGMutedTextStyle}" />
                            <InfoBar
                                IsClosable="False"
                                IsOpen="{x:Bind Join.HasHint, Mode=OneWay}"
                                Message="{x:Bind Join.Hint, Mode=OneWay}"
                                Severity="Warning" />
                            <TextBlock x:Uid="McJoin_ConsoleIntro" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="McJoin_ConsoleStep1" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="McJoin_ConsoleStep2" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="McJoin_ConsoleStep3" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Uid="McJoin_Gamertag" VerticalAlignment="Center" Style="{StaticResource RoGMutedTextStyle}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    IsTextSelectionEnabled="True"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource RoGBodyTextStyle}"
                                    Text="{x:Bind Join.Gamertag, Mode=OneWay}" />
                                <Button x:Uid="McJoin_CopyGamertag" Command="{x:Bind Join.CopyGamertagCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock x:Uid="McJoin_ConsoleTrouble" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Uid="McJoin_LinkTip" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Uid="McJoin_Map" Click="OnMapClick" Style="{StaticResource RoGPrimaryButtonStyle}" />
                        <Button x:Uid="McJoin_Leaderboards" Click="OnLeaderboardsClick" Style="{StaticResource RoGSecondaryButtonStyle}" />
                        <Button
                            x:Uid="McJoin_LinkAccount"
                            Click="OnLinkAccountClick"
                            Style="{StaticResource RoGSecondaryButtonStyle}"
                            Visibility="{x:Bind Join.IsSignedIn}" />
                    </StackPanel>

                    <!-- Bearbeiten (minecraft.manage) -->
                    <Expander
                        x:Uid="McJoin_Edit"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Expanding="OnJoinEditExpanding"
                        Visibility="{x:Bind Join.CanEdit}">
                        <StackPanel Spacing="12">
                            <ProgressRing x:Uid="McJoin_EditLoading" IsActive="{x:Bind Join.IsEditLoading, Mode=OneWay}" />
                            <TextBlock x:Uid="McJoin_EditLead" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                            <TextBox x:Uid="McJoin_EditJavaAddress" MaxLength="253" Text="{x:Bind Join.EditJavaAddress, Mode=TwoWay}" />
                            <NumberBox
                                x:Uid="McJoin_EditJavaPort"
                                Width="200"
                                HorizontalAlignment="Left"
                                Maximum="65535"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind Join.EditJavaPort, Mode=TwoWay}" />
                            <TextBox x:Uid="McJoin_EditBedrockAddress" MaxLength="253" Text="{x:Bind Join.EditBedrockAddress, Mode=TwoWay}" />
                            <NumberBox
                                x:Uid="McJoin_EditBedrockPort"
                                Width="200"
                                HorizontalAlignment="Left"
                                Maximum="65535"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind Join.EditBedrockPort, Mode=TwoWay}" />
                            <ToggleSwitch x:Uid="McJoin_EditConsoleEnabled" IsOn="{x:Bind Join.EditConsoleEnabled, Mode=TwoWay}" />
                            <TextBox x:Uid="McJoin_EditGamertag" MaxLength="20" Text="{x:Bind Join.EditGamertag, Mode=TwoWay}" />
                            <TextBlock x:Uid="McJoin_EditHintNote" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                            <TextBox
                                x:Uid="McJoin_EditHintDe"
                                AcceptsReturn="True"
                                MaxLength="500"
                                Text="{x:Bind Join.EditHintDe, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Uid="McJoin_EditHintEn"
                                AcceptsReturn="True"
                                MaxLength="500"
                                Text="{x:Bind Join.EditHintEn, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Uid="McJoin_EditHintFr"
                                AcceptsReturn="True"
                                MaxLength="500"
                                Text="{x:Bind Join.EditHintFr, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Uid="McJoin_EditSave"
                                Command="{x:Bind Join.SaveCommand}"
                                IsEnabled="{x:Bind Join.CanSave, Mode=OneWay}"
                                Style="{StaticResource RoGPrimaryButtonStyle}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- TeamSpeak -->
        <Grid
            x:Name="TeamSpeakPanel"
            Grid.Row="2"
            Grid.RowSpan="3"
            RowSpacing="12"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource RoGTitleTextStyle}" Text="{x:Bind Voice.TeamSpeakTitle, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Voice.TeamSpeakStatus, Mode=OneWay}" />
                    <ToggleSwitch x:Uid="ServersPage_ShowEmptyChannels" IsOn="{x:Bind Voice.ShowEmptyChannels, Mode=TwoWay}" />
                </StackPanel>
                <Button
                    x:Uid="ServersPage_TsConnect"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Command="{x:Bind Voice.ConnectCommand}"
                    IsEnabled="{x:Bind Voice.CanConnect, Mode=OneWay}"
                    Style="{StaticResource RoGPrimaryButtonStyle}" />
            </Grid>
            <controls:StateView
                x:Uid="ServersPage_TsState"
                Grid.Row="1"
                ErrorMessage="{x:Bind Voice.ErrorMessage, Mode=OneWay}"
                IsEmpty="{x:Bind Voice.ShowTeamSpeakEmpty, Mode=OneWay}"
                IsLoading="{x:Bind Voice.IsLoading, Mode=OneWay}"
                RetryCommand="{x:Bind Voice.RefreshCommand}" />
            <ListView
                x:Uid="ServersPage_TsList"
                Grid.Row="1"
                ItemsSource="{x:Bind Voice.TeamSpeakRows}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VoiceRow">
                        <StackPanel
                            Margin="{x:Bind Indent}"
                            Orientation="Horizontal"
                            Spacing="8"
                            AutomationProperties.Name="{x:Bind Text}">
                            <FontIcon
                                FontSize="14"
                                Foreground="{x:Bind Foreground}"
                                Glyph="{x:Bind Glyph}"
                                AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Foreground="{x:Bind Foreground}" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Text}" />
                            <TextBlock
                                Foreground="{StaticResource RoGGoldBrush}"
                                Style="{StaticResource RoGBodyTextStyle}"
                                Text="{x:Bind Detail}"
                                Visibility="{x:Bind HasDetail}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Discord -->
        <Grid
            x:Name="DiscordPanel"
            Grid.Row="2"
            Grid.RowSpan="3"
            Visibility="Collapsed">
            <controls:StateView
                x:Uid="ServersPage_DiscordState"
                ErrorMessage="{x:Bind Voice.ErrorMessage, Mode=OneWay}"
                IsEmpty="{x:Bind Voice.ShowDiscordEmpty, Mode=OneWay}"
                IsLoading="{x:Bind Voice.IsLoading, Mode=OneWay}"
                RetryCommand="{x:Bind Voice.RefreshCommand}" />
            <ListView
                x:Uid="ServersPage_DiscordList"
                ItemsSource="{x:Bind Voice.DiscordRows}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VoiceRow">
                        <StackPanel
                            Margin="{x:Bind Indent}"
                            Orientation="Horizontal"
                            Spacing="8"
                            AutomationProperties.Name="{x:Bind Text}">
                            <FontIcon
                                FontSize="14"
                                Foreground="{x:Bind Foreground}"
                                Glyph="{x:Bind Glyph}"
                                Visibility="{x:Bind IsChannel}"
                                AutomationProperties.AccessibilityView="Raw" />
                            <PersonPicture
                                Width="24"
                                Height="24"
                                DisplayName="{x:Bind Text}"
                                ProfilePicture="{x:Bind Avatar}"
                                Visibility="{x:Bind IsPerson}"
                                AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Foreground="{x:Bind Foreground}" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Text}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
