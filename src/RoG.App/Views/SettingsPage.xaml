<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource RoGReadingWidth}"
            Padding="{StaticResource RoGPagePadding}"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock x:Uid="SettingsPage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="EINSTELLUNGEN" />

            <InfoBar
                x:Uid="SettingsPage_RestartHint"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.RestartRequired, Mode=OneWay}"
                Severity="Informational" />

            <!-- Allgemein -->
            <Border Style="{StaticResource RoGCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="SettingsPage_GeneralTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <ComboBox
                        x:Uid="SettingsPage_Language"
                        MinWidth="260"
                        ItemsSource="{x:Bind ViewModel.Languages}"
                        SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Benachrichtigungen (Website, E-Mail, Discord) -->
            <Expander
                x:Uid="SettingsPage_Notifications"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Expanding="OnNotificationsExpanding"
                Visibility="{x:Bind ShowNotificationSettings}">
                <StackPanel Spacing="12">
                    <InfoBar
                        IsOpen="{x:Bind Notifications.IsFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind Notifications.FeedbackMessage, Mode=OneWay}"
                        Severity="{x:Bind Notifications.FeedbackSeverity, Mode=OneWay}" />
                    <ComboBox x:Uid="SettingsPage_Digest" MinWidth="220" ItemsSource="{x:Bind Notifications.DigestOptions}" SelectedItem="{x:Bind Notifications.SelectedDigest, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Uid="SettingsPage_QuietFrom" Width="110" Text="{x:Bind Notifications.QuietFrom, Mode=TwoWay}" />
                        <TextBox x:Uid="SettingsPage_QuietUntil" Width="110" Text="{x:Bind Notifications.QuietUntil, Mode=TwoWay}" />
                        <Button x:Uid="SettingsPage_QuietSave" VerticalAlignment="Bottom" Command="{x:Bind Notifications.SaveQuietHoursCommand}" />
                    </StackPanel>
                    <ProgressRing HorizontalAlignment="Left" IsActive="{x:Bind Notifications.IsLoading, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind Notifications.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NotificationTypeRowViewModel">
                                <Grid Padding="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Label}" TextWrapping="Wrap" />
                                    <CheckBox x:Uid="SettingsPage_ChannelBell" Grid.Column="1" MinWidth="0" IsChecked="{x:Bind Bell, Mode=TwoWay}" Visibility="{x:Bind ShowBell}" />
                                    <CheckBox x:Uid="SettingsPage_ChannelMail" Grid.Column="2" MinWidth="0" IsChecked="{x:Bind Mail, Mode=TwoWay}" Visibility="{x:Bind ShowMail}" />
                                    <CheckBox x:Uid="SettingsPage_ChannelDiscord" Grid.Column="3" MinWidth="0" IsChecked="{x:Bind Discord, Mode=TwoWay}" Visibility="{x:Bind ShowDiscord}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- Windows -->
            <Border Style="{StaticResource RoGCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsPage_WindowsTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <ToggleSwitch x:Uid="SettingsPage_Toasts" IsOn="{x:Bind ViewModel.Toasts, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="SettingsPage_CloseToTray" IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
                    <ToggleSwitch
                        x:Uid="SettingsPage_Autostart"
                        IsEnabled="{x:Bind ViewModel.CanChangeAutostart, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.Autostart, Mode=TwoWay}" />
                    <TextBlock
                        Style="{StaticResource RoGMutedTextStyle}"
                        Text="{x:Bind ViewModel.AutostartHint, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasAutostartHint, Mode=OneWay}" />
                    <ToggleSwitch
                        x:Uid="SettingsPage_AppLock"
                        IsEnabled="{x:Bind ViewModel.CanUseAppLock, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.AppLock, Mode=TwoWay}" />
                    <TextBlock
                        x:Uid="SettingsPage_AppLockHint"
                        Style="{StaticResource RoGMutedTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowAppLockHint, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Über -->
            <Border Style="{StaticResource RoGCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsPage_AboutTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.AppVersionText}" />
                    <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.PlatformText, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton x:Uid="SettingsPage_Website" Command="{x:Bind ViewModel.OpenWebsiteCommand}" />
                        <HyperlinkButton x:Uid="SettingsPage_Status" Command="{x:Bind ViewModel.OpenStatusCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton x:Uid="SettingsPage_Privacy" Command="{x:Bind ViewModel.OpenPrivacyCommand}" />
                        <HyperlinkButton x:Uid="SettingsPage_Terms" Command="{x:Bind ViewModel.OpenTermsCommand}" />
                        <HyperlinkButton x:Uid="SettingsPage_Imprint" Command="{x:Bind ViewModel.OpenImprintCommand}" />
                        <HyperlinkButton x:Uid="SettingsPage_ChildSafety" Command="{x:Bind ViewModel.OpenChildSafetyCommand}" />
                    </StackPanel>
                    <!-- Copyright wie im Website-Footer: Clan, dahinter „Copyright by wahke“ mit Link -->
                    <TextBlock Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap">
                        <Run Text="{x:Bind ViewModel.CopyrightText}" />
                        <Run Text="·" />
                        <Run x:Uid="SettingsPage_Credit" />
                        <Hyperlink x:Uid="SettingsPage_CreditLink"><Run x:Uid="SettingsPage_CreditName" /></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Lizenzen -->
            <Border Style="{StaticResource RoGCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsPage_LicensesTitle" Style="{StaticResource RoGSectionTextStyle}" />
                    <TextBlock x:Uid="SettingsPage_LicensesText" Style="{StaticResource RoGMutedTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
