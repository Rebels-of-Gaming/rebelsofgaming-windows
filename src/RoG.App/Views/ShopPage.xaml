<?xml version="1.0" encoding="utf-8"?>
<!-- Shop & Spenden (Website v0.47.0): nur Anzeige; Kaufen und Spenden auf der Website. -->
<Page
    x:Class="RoG.App.Views.ShopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="{StaticResource RoGPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="8">
            <TextBlock x:Uid="ShopPage_Title" Style="{StaticResource RoGDisplayTextStyle}" />
            <TextBlock x:Uid="ShopPage_Intro" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <controls:StateView
            x:Uid="ShopPage_State"
            Grid.Row="1"
            ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
            IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
        <ScrollViewer Grid.Row="1" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="16">
                <TextBlock x:Uid="ShopPage_Closed" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.IsClosed, Mode=OneWay}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Products}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShopProductViewModel">
                            <Border Margin="0,0,0,12" Style="{StaticResource RoGCardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RoGSectionTextStyle}" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource RoGGoldBrush}" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Price}" />
                                    </Grid>
                                    <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Description}" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
                                    <Button x:Uid="ShopPage_BuyOnWebsite" Command="{x:Bind OpenCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource RoGCardStyle}" Visibility="{x:Bind ViewModel.HasDonations, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="ShopPage_DonateTitle" Style="{StaticResource RoGSectionTextStyle}" />
                        <TextBlock x:Uid="ShopPage_DonateText" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.DonationRange, Mode=OneWay}" />
                        <Button x:Uid="ShopPage_DonateOnWebsite" Command="{x:Bind ViewModel.DonateCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasSupporters, Mode=OneWay}">
                            <TextBlock x:Uid="ShopPage_Supporters" Style="{StaticResource RoGMutedTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Supporters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasOrders, Mode=OneWay}">
                    <TextBlock x:Uid="ShopPage_Orders" Style="{StaticResource RoGSectionTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Orders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShopOrderViewModel">
                                <Grid Padding="0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" TextWrapping="Wrap" />
                                        <HyperlinkButton x:Uid="ShopPage_Receipt" Padding="0" Command="{x:Bind OpenReceiptCommand}" Visibility="{x:Bind HasReceipt}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Price}" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource RoGGoldBrush}" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Status}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Uid="Common_LoadMore" Command="{x:Bind ViewModel.MoreOrdersCommand}" Visibility="{x:Bind ViewModel.HasMoreOrders, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
