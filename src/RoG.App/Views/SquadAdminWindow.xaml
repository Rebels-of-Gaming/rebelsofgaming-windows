<?xml version="1.0" encoding="utf-8"?>
<!-- Squad verwalten im eigenen Fenster (Stufe 9): Profil, Line-up, Archiv. -->
<Window
    x:Class="RoG.App.Views.SquadAdminWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RoG.App.ViewModels">

    <Grid Background="{StaticResource RoGBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Padding="16,0,140,0" Background="{StaticResource RoGBg2Brush}">
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                FontFamily="{StaticResource RoGDisplaySemiBoldFont}"
                FontSize="14"
                CharacterSpacing="60"
                Foreground="{StaticResource RoGMutedBrush}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="16,8,16,0"
            IsOpen="{x:Bind ViewModel.IsFeedbackOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.FeedbackSeverity, Mode=OneWay}" />

        <SelectorBar x:Name="Tabs" Grid.Row="2" Margin="12,0" SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Name="ProfileTab" x:Uid="SquadAdmin_TabProfile" />
            <SelectorBarItem x:Name="MembersTab" x:Uid="SquadAdmin_TabMembers" />
            <SelectorBarItem x:Name="ArchiveTab" x:Uid="SquadAdmin_TabArchive" />
        </SelectorBar>

        <!-- Profil -->
        <ScrollViewer x:Name="ProfilePanel" Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="{StaticResource RoGReadingWidth}" Padding="16,8,16,24" HorizontalAlignment="Left" Spacing="12">
                <TextBlock x:Uid="SquadAdmin_LanguageHint" FontSize="12" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                <TextBox x:Uid="SquadAdmin_Tagline" MaxLength="200" Text="{x:Bind ViewModel.Tagline, Mode=TwoWay}" />
                <TextBox x:Uid="SquadAdmin_Description" MinHeight="140" AcceptsReturn="True" Text="{x:Bind ViewModel.Description, Mode=TwoWay}" TextWrapping="Wrap" />
                <TextBox x:Uid="SquadAdmin_Training" AcceptsReturn="True" Text="{x:Bind ViewModel.TrainingTimes, Mode=TwoWay}" TextWrapping="Wrap" />
                <ComboBox x:Uid="SquadAdmin_Recruiting" MinWidth="240" ItemsSource="{x:Bind ViewModel.RecruitingOptions}" SelectedItem="{x:Bind ViewModel.SelectedRecruiting, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBox x:Uid="SquadAdmin_ClanTag" Width="140" MaxLength="32" Text="{x:Bind ViewModel.ClanTag, Mode=TwoWay}" />
                    <TextBox x:Uid="SquadAdmin_ClanName" Width="260" MaxLength="80" Text="{x:Bind ViewModel.ClanName, Mode=TwoWay}" />
                    <NumberBox x:Uid="SquadAdmin_ClanLevel" Width="140" Maximum="9999" Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.ClanLevel, Mode=TwoWay}" />
                </StackPanel>
                <TextBox x:Uid="SquadAdmin_ClanRequirements" AcceptsReturn="True" Text="{x:Bind ViewModel.ClanRequirements, Mode=TwoWay}" TextWrapping="Wrap" />
                <Button x:Uid="SquadAdmin_Save" Command="{x:Bind ViewModel.SaveProfileCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />

                <TextBlock x:Uid="SquadAdmin_ImagesTitle" Margin="0,12,0,0" Style="{StaticResource RoGSectionTextStyle}" />
                <TextBlock x:Uid="SquadAdmin_ImagesHint" FontSize="12" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="SquadAdmin_SetLogo" Click="OnSetLogoClick" Style="{StaticResource RoGSecondaryButtonStyle}" />
                    <Button x:Uid="SquadAdmin_RemoveLogoButton" Click="OnRemoveLogoClick" />
                    <Button x:Uid="SquadAdmin_SetHeader" Click="OnSetHeaderClick" Style="{StaticResource RoGSecondaryButtonStyle}" />
                    <Button x:Uid="SquadAdmin_RemoveHeaderButton" Click="OnRemoveHeaderClick" />
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Line-up -->
        <Grid x:Name="MembersPanel" Grid.Row="3" Padding="16,8,16,16" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SquadAdmin_AddTitle" Style="{StaticResource RoGSectionTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <AutoSuggestBox
                        x:Uid="SquadAdmin_MemberSearch"
                        Width="260"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind ViewModel.Suggestions}"
                        SuggestionChosen="OnMemberChosen"
                        TextChanged="OnMemberSearchChanged"
                        TextMemberPath="Name" />
                    <ComboBox
                        x:Uid="SquadAdmin_Role"
                        MinWidth="180"
                        VerticalAlignment="Bottom"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.Roles}"
                        SelectedItem="{x:Bind ViewModel.NewMemberRole, Mode=TwoWay}" />
                    <CheckBox x:Uid="SquadAdmin_Substitute" VerticalAlignment="Bottom" IsChecked="{x:Bind ViewModel.NewMemberSubstitute, Mode=TwoWay}" />
                    <Button x:Uid="SquadAdmin_Add" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.AddMemberCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                </StackPanel>
                <TextBlock x:Uid="SquadAdmin_RolesHint" FontSize="12" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Lineup}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SquadAdminMemberViewModel">
                            <Grid Padding="0,6" ColumnSpacing="8" AutomationProperties.Name="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <ComboBox
                                    x:Uid="SquadAdmin_MemberRole"
                                    Grid.Column="1"
                                    MinWidth="170"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{x:Bind Roles}"
                                    SelectedItem="{x:Bind SelectedRole, Mode=TwoWay}" />
                                <CheckBox x:Uid="SquadAdmin_Substitute" Grid.Column="2" IsChecked="{x:Bind Substitute, Mode=TwoWay}" />
                                <Button x:Uid="SquadAdmin_SaveMember" Grid.Column="3" Command="{x:Bind SaveCommand}" />
                                <Button x:Uid="SquadAdmin_RemoveMember" Grid.Column="4" Command="{x:Bind RemoveCommand}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Archiv -->
        <StackPanel x:Name="ArchivePanel" Grid.Row="3" Padding="16,8,16,16" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Uid="SquadAdmin_ArchiveHint" MaxWidth="600" HorizontalAlignment="Left" Style="{StaticResource RoGBodyTextStyle}" TextWrapping="Wrap" />
            <Button Command="{x:Bind ViewModel.ToggleArchiveCommand}" Content="{x:Bind ViewModel.ArchiveLabel, Mode=OneWay}" Style="{StaticResource RoGSecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
