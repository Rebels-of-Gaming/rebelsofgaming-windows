<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.SquadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <controls:ListDetailPanel DetailClosed="OnDetailClosed" IsDetailOpen="{x:Bind ViewModel.IsDetailOpen, Mode=OneWay}">
        <controls:ListDetailPanel.List>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="24,24,24,12" Spacing="8">
                    <TextBlock
                        x:Uid="SquadsPage_Title"
                        Style="{StaticResource RoGDisplayTextStyle}"
                        Text="SQUADS" />
                    <SelectorBar SelectionChanged="OnModeChanged">
                        <SelectorBarItem x:Uid="SquadsPage_ModeSquads" IsSelected="True" />
                        <SelectorBarItem x:Uid="SquadsPage_ModeGames" />
                    </SelectorBar>
                </StackPanel>
                <controls:StateView
                    x:Uid="SquadsPage_State"
                    Grid.Row="1"
                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
                <ListView
                    x:Uid="SquadsPage_List"
                    Grid.Row="1"
                    Padding="12,0,12,12"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.ShowSquads, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SquadItemViewModel">
                            <Grid Padding="0,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="48"
                                    Height="48"
                                    Background="{StaticResource RoGBg3Brush}"
                                    CornerRadius="{StaticResource RoGControlRadius}">
                                    <Image Source="{x:Bind Logo}" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource RoGBodyTextStyle}"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        MaxLines="1"
                                        Style="{StaticResource RoGMutedTextStyle}"
                                        Text="{x:Bind Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind HasRecruiting}">
                                        <Ellipse Fill="{x:Bind RecruitingBrush}" Style="{StaticResource RoGStatusDotStyle}" />
                                        <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind RecruitingText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Spiele -->
                <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.GamesMode, Mode=OneWay}">
                    <controls:StateView
                        x:Uid="SquadsPage_GamesState"
                        ErrorMessage="{x:Bind ViewModel.Games.ErrorMessage, Mode=OneWay}"
                        IsEmpty="{x:Bind ViewModel.Games.IsEmpty, Mode=OneWay}"
                        IsLoading="{x:Bind ViewModel.Games.IsLoading, Mode=OneWay}"
                        RetryCommand="{x:Bind ViewModel.Games.RefreshCommand}" />
                    <ScrollViewer Padding="12,0,12,12" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.Games.ShowContent, Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Games.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameItemViewModel">
                                    <Border Margin="0,0,0,8" Style="{StaticResource RoGCardStyle}" AutomationProperties.Name="{x:Bind Title}">
                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Title}" />
                                            <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                            <ItemsControl ItemsSource="{x:Bind Links}" Visibility="{x:Bind HasLinks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GameLinkViewModel">
                                                        <HyperlinkButton Padding="0,2" Command="{x:Bind OpenCommand}" Content="{x:Bind Label}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </controls:ListDetailPanel.List>

        <!-- Squad-Seite -->
        <Grid>
            <TextBlock
                x:Uid="SquadsPage_SelectHint"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource RoGMutedTextStyle}"
                Visibility="{x:Bind ViewModel.ShowSelectHint, Mode=OneWay}" />
            <controls:StateView
                ErrorMessage="{x:Bind ViewModel.Detail.ErrorMessage, Mode=OneWay}"
                IsLoading="{x:Bind ViewModel.Detail.IsLoading, Mode=OneWay}"
                RetryCommand="{x:Bind ViewModel.Detail.RefreshCommand}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.Detail.ShowContent, Mode=OneWay}">
                <StackPanel Padding="32,24,32,32" Spacing="20">
                    <!-- Kopf -->
                    <Grid MaxHeight="240" CornerRadius="{StaticResource RoGCardRadius}">
                        <Image Source="{x:Bind ViewModel.Detail.Header, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="72"
                            Height="72"
                            Background="{StaticResource RoGBg3Brush}"
                            CornerRadius="{StaticResource RoGControlRadius}">
                            <Image Source="{x:Bind ViewModel.Detail.Logo, Mode=OneWay}" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                Style="{StaticResource RoGTitleTextStyle}"
                                Text="{x:Bind ViewModel.Detail.Name, Mode=OneWay}"
                                AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Detail.Subtitle, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Fill="{x:Bind ViewModel.Detail.RecruitingBrush, Mode=OneWay}" Style="{StaticResource RoGStatusDotStyle}" />
                                <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Detail.RecruitingText, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                x:Uid="SquadsPage_Apply"
                                Margin="0,6,0,0"
                                Click="OnApplyClick"
                                Style="{StaticResource RoGPrimaryButtonStyle}"
                                Visibility="{x:Bind ViewModel.Detail.CanApply, Mode=OneWay}" />
                            <Button
                                x:Uid="SquadsPage_Manage"
                                Margin="0,6,0,0"
                                Click="OnManageClick"
                                Style="{StaticResource RoGSecondaryButtonStyle}"
                                Visibility="{x:Bind ViewModel.Detail.CanManage, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <InfoBar
                        IsOpen="{x:Bind ViewModel.Detail.IsFeedbackOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.Detail.FeedbackMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.Detail.FeedbackSeverity, Mode=OneWay}" />

                    <!-- Vorstellung -->
                    <StackPanel MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock x:Uid="SquadsPage_About" Style="{StaticResource RoGSectionTextStyle}" />
                        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Detail.Description, Mode=OneWay}" />
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Detail.HasTrainingTimes, Mode=OneWay}">
                            <TextBlock x:Uid="SquadsPage_Training" Style="{StaticResource RoGMutedTextStyle}" />
                            <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Detail.TrainingTimes, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Detail.ClanInfo, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Links -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Detail.HasLinks, Mode=OneWay}">
                        <TextBlock x:Uid="SquadsPage_Links" Style="{StaticResource RoGSectionTextStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Links}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:LinkViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Command="{x:Bind OpenCommand}"
                                            Content="{x:Bind Label}"
                                            Style="{StaticResource RoGSecondaryButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind Url}" />
                                        <Button x:Uid="Common_Copy" Command="{x:Bind CopyCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource RoGMutedTextStyle}"
                                            Text="{x:Bind Code}"
                                            Visibility="{x:Bind HasCode}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Galerie -->
                    <Expander x:Uid="SquadsPage_Gallery" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="OnGalleryExpanding">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="SquadsPage_GalleryEmpty" Style="{StaticResource RoGMutedTextStyle}" Visibility="{x:Bind ViewModel.Detail.HasNoGallery, Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Gallery}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinColumnSpacing="6" MinItemHeight="96" MinItemWidth="128" MinRowSpacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SquadGalleryItemViewModel">
                                        <Button Padding="0" AutomationProperties.Name="{x:Bind Caption}" Command="{x:Bind OpenCommand}" ToolTipService.ToolTip="{x:Bind Caption}">
                                            <Image Width="128" Height="96" Source="{x:Bind Thumb}" Stretch="UniformToFill" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Expander>

                    <!-- Tools (Tool-Baukasten) -->
                    <Expander x:Uid="SquadsPage_Tools" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="OnToolsExpanding">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind ViewModel.Detail.ToolsHint, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.Detail.HasToolsHint, Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Tools}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ToolItemViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Button Command="{x:Bind OpenCommand}" Content="{x:Bind Name}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasDescription}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Expander>

                    <!-- Statistiken -->
                    <Expander x:Uid="SquadsPage_Stats" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="OnStatsExpanding">
                        <TextBlock FontFamily="Consolas" FontSize="13" IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind ViewModel.Detail.StatsText, Mode=OneWay}" TextWrapping="Wrap" />
                    </Expander>

                    <!-- Server -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Detail.HasServers, Mode=OneWay}">
                        <TextBlock x:Uid="SquadsPage_Servers" Style="{StaticResource RoGSectionTextStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Servers}">
                            <ItemsRepeater.Layout>
                                <!-- Zeilenhöhe je höchster Karte: aufgeklappte Ports/Auslastung werden nicht abgeschnitten -->
<controls:CardGridLayout ColumnSpacing="16" MinItemWidth="300" RowSpacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServerItemViewModel">
                                    <controls:ServerCard Item="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Line-up -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Detail.HasMembers, Mode=OneWay}">
                        <TextBlock Style="{StaticResource RoGSectionTextStyle}" Text="{x:Bind ViewModel.Detail.MembersHeader, Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Members}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="12"
                                    MinItemWidth="240"
                                    MinRowSpacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:MemberRowViewModel">
                                    <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <PersonPicture
                                            Width="36"
                                            Height="36"
                                            DisplayName="{x:Bind Name}"
                                            ProfilePicture="{x:Bind Avatar}"
                                            AutomationProperties.AccessibilityView="Raw" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{x:Bind RoleBrush}"
                                                Text="{x:Bind Role}"
                                                Visibility="{x:Bind HasRole}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </controls:ListDetailPanel>
</Page>
