<?xml version="1.0" encoding="utf-8"?>
<!-- Tools aus dem Tool-Baukasten der Website, nach Spiel gruppiert; ein Tool öffnet im eigenen Fenster. -->
<Page
    x:Class="RoG.App.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Grid Padding="{StaticResource RoGPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Uid="ToolsPage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="TOOLS" />
            <TextBlock x:Uid="ToolsPage_Intro" Style="{StaticResource RoGMutedTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <controls:StateView
            x:Uid="ToolsPage_State"
            Grid.Row="1"
            ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
            IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="24" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolGroupViewModel">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource RoGSectionTextStyle}" Text="{x:Bind Header}" />
                            <ItemsRepeater ItemsSource="{x:Bind Tools}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="16" MinItemWidth="280" MinRowSpacing="16" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ToolItemViewModel">
                                        <Button
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            VerticalContentAlignment="Top"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind OpenCommand}">
                                            <Border Style="{StaticResource RoGCardStyle}">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Style="{StaticResource RoGTitleTextStyle}" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Description}" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
                                                    <TextBlock FontSize="12" Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" Visibility="{x:Bind HasMeta}" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
