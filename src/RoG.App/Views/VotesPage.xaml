<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RoG.App.Views.VotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoG.App.Controls"
    xmlns:vm="using:RoG.App.ViewModels"
    Background="{StaticResource RoGBgBrush}">

    <Grid Padding="{StaticResource RoGPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="VotesPage_Title" Style="{StaticResource RoGDisplayTextStyle}" Text="ABSTIMMUNGEN" />
        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.IsFeedbackOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.FeedbackSeverity, Mode=OneWay}" />
        <controls:StateView
            x:Uid="VotesPage_State"
            Grid.Row="2"
            ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
            IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.RefreshCommand}" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
            <ItemsRepeater MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" ItemsSource="{x:Bind ViewModel.Items}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:VoteItemViewModel">
                        <Border Style="{StaticResource RoGCardStyle}" AutomationProperties.Name="{x:Bind Title}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource RoGTitleTextStyle}" Text="{x:Bind Title}" />
                                <TextBlock Style="{StaticResource RoGMutedTextStyle}" Text="{x:Bind Meta}" />
                                <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Answers}" />
                                <TextBlock Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind Tasks}" Visibility="{x:Bind HasTasks}" />
                                <TextBlock Foreground="{StaticResource RoGGoldBrush}" Style="{StaticResource RoGBodyTextStyle}" Text="{x:Bind MyVote}" Visibility="{x:Bind HasMyVote}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Uid="VotesPage_Yes" Command="{x:Bind YesCommand}" Style="{StaticResource RoGPrimaryButtonStyle}" />
                                    <Button x:Uid="VotesPage_No" Command="{x:Bind NoCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                                    <Button x:Uid="VotesPage_Abstain" Command="{x:Bind AbstainCommand}" Style="{StaticResource RoGSecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
